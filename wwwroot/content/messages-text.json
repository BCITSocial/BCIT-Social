      "messages": [
        { "id": 101, "text": "Hey! I saw your post about organizing MVC controllers. I'm working on a project and wondering how you structure your folders? Do you keep feature folders, or everything in a flat structure?", "sentAt": "2026-10-21T10:12:00", "isMine": false },
        { "id": 102, "text": "Hey Maya! I usually go with feature folders. Each feature has its own Controllers, Models, and Views folders. It keeps things organized and makes it easier to navigate as the project grows.", "sentAt": "2026-10-21T10:18:00", "isMine": true, "isRead": true },
        { "id": 103, "text": "That makes sense! I'll try that approach. I've found it gets messy quickly when everything is in one folder, especially as the project grows.", "sentAt": "2026-10-21T10:21:00", "isMine": false },
        { "id": 104, "text": "Totally. If you want, I can share my folder structure with you and the team. It might be a good reference.", "sentAt": "2026-10-21T10:23:00", "isMine": true, "isRead": true },
        { "id": 105, "text": "Definitely! I'll send you what we have.", "sentAt": "2026-10-21T10:24:00", "isMine": false }
      ]
