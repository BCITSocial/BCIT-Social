@using System.Globalization
@model EventCardViewModel
@* One event card, built from one entry in wwwroot/content/events-text.json. A row is left out when its value is empty. *@
@{
    var culture = CultureInfo.InvariantCulture;

    // Same-day events read "5:30 – 7:00 PM" (the first AM/PM is dropped when both match).
    // Multi-day events show the full date and time for both ends.
    var time = "";
    if (Model.StartsAt is { } start)
    {
        if (Model.EndsAt is { } end && end.Date == start.Date)
        {
            var samePeriod = (start.Hour < 12) == (end.Hour < 12);
            time = start.ToString(samePeriod ? "h:mm" : "h:mm tt", culture) + " – " + end.ToString("h:mm tt", culture);
        }
        else if (Model.EndsAt is { } until)
        {
            time = start.ToString("ddd, MMM d · h:mm tt", culture) + " – " + until.ToString("ddd, MMM d · h:mm tt", culture);
        }
        else
        {
            time = start.ToString("h:mm tt", culture);
        }
    }

    // "Location · Campus", skipping whichever part is empty.
    var where = string.Join(" · ", new[] { Model.Location, Model.Campus }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // Text of the badge in the top-right corner of the cover. Null means no badge.
    var status = Model.IsCancelled ? "Cancelled" : Model.Rsvp switch
    {
        RsvpStatus.Going => "Going",
        RsvpStatus.Interested => "Interested",
        RsvpStatus.Hosting => "Hosting",
        _ => null,
    };
    var interested = Model.Rsvp == RsvpStatus.Interested;
    var going = Model.Rsvp == RsvpStatus.Going;
}
<article class="event-card@(Model.IsCancelled ? " is-cancelled" : "")">
    <div class="event-cover">
        @if (!string.IsNullOrWhiteSpace(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" alt="@Model.CoverImageAlt" loading="lazy" />
        }
        @if (Model.StartsAt is { } startsAt)
        {
            <time class="event-date" datetime="@startsAt.ToString("yyyy-MM-dd'T'HH:mm", culture)">
                <span class="event-month">@startsAt.ToString("MMM", culture)</span>
                <span class="event-day">@startsAt.Day</span>
            </time>
        }
        @if (status is not null)
        {
            <span class="event-status status-@status.ToLowerInvariant()">@status</span>
        }
    </div>
    @* Top to bottom: title, host, time, location, description, attendees, buttons. *@
    <div class="event-body">
        <h3 class="event-title">@Model.Title</h3>
        <dl class="event-meta">
            @if (Model.HostName.Length > 0)
            {
                <div class="event-host"><dt class="visually-hidden">Host</dt><dd><partial name="_Icon" model='"people"' /><span>@Model.HostName</span></dd></div>
            }
            @if (time.Length > 0)
            {
                <div class="event-time"><dt class="visually-hidden">Time</dt><dd><partial name="_Icon" model='"clock"' /><span>@time</span></dd></div>
            }
            @if (where.Length > 0)
            {
                <div class="event-where"><dt class="visually-hidden">Location</dt><dd><partial name="_Icon" model='"pin"' /><span>@where</span></dd></div>
            }
        </dl>
        @if (Model.Description.Length > 0)
        {
            <p class="event-description">@Model.Description</p>
        }
        <div class="event-footer">
            @if (Model.Attendees.Count > 0 || Model.GoingCount > 0)
            {
                <div class="event-attendees">
                    <span class="avatar-stack" aria-hidden="true">
                        @foreach (var attendee in Model.Attendees.Take(3))
                        {
                            if (!string.IsNullOrWhiteSpace(attendee.PhotoUrl))
                            {
                                <img class="avatar" src="@attendee.PhotoUrl" alt="" />
                            }
                            else
                            {
                                <span class="avatar">@attendee.Initials</span>
                            }
                        }
                    </span>
                    @if (Model.GoingCount > 0)
                    {
                        <span class="going-count">@Model.GoingCount going</span>
                    }
                </div>
            }
            @* TODO(BE): these buttons stay disabled until the RSVP and event detail/manage endpoints exist. *@
            <div class="event-actions">
                @if (Model.Rsvp == RsvpStatus.Hosting)
                {
                    <button class="action-button" type="button" disabled><partial name="_Icon" model='"external"' />View event</button>
                    <button class="action-button action-hosting" type="button" disabled>Manage event</button>
                }
                else
                {
                    <button class="action-button action-interested@(interested ? " is-selected" : "")" type="button" aria-pressed="@(interested ? "true" : "false")" disabled><partial name="_Icon" model='"star"' />Interested</button>
                    <button class="action-button action-going@(going ? " is-selected" : "")" type="button" aria-pressed="@(going ? "true" : "false")" disabled><partial name="_Icon" model='"check"' />Going</button>
                }
            </div>
        </div>
    </div>
</article>
