@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    string? Page(string controller) => string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
<nav class="sidebar" aria-label="Main navigation">
    <a asp-controller="Home" asp-action="Index" aria-current="@Page("Home")">Home</a>
    @* Replace disabled controls with route links as the team adds each screen. *@
    <button type="button" disabled>Communities</button>
    <a asp-controller="Events" asp-action="Index" aria-current="@Page("Events")">Events</a>
    <button type="button" disabled>Profile</button>
    <button type="button" disabled>Messages</button>
</nav>
