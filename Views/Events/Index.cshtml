@using BCIT_Social.ViewModels
@model EventsViewModel
@{
    var text = Model.Text;
    ViewData["Title"] = text.PageTitle;
    Layout = "_HomeLayout";
    // The event cards read their badge and button text from here.
    ViewData[nameof(EventsText)] = text;
    // No right rail here: its "Upcoming events" card would repeat this page.
}

@* Events page: heading with the Create button, tabs (My calendar first), then the calendar or the Discover filters and cards.
   All wording comes from Model.Text (the "text" section of events-text.json); this file only places it. *@
<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

@* Shown once after an event is created. TODO(BE): the Create action sets TempData["EventCreated"] = true before redirecting here. *@
@if (TempData["EventCreated"] is true)
{
    <p class="events-notice" role="status">@text.CreateEvent.Created</p>
}
@if (TempData["EventMessage"] is string message)
{
    <p class="events-notice" role="alert">@message</p>
}

<section class="panel events-panel" aria-labelledby="events-heading">
    @* Heading on the left, "Create event" on the right like the other pages. *@
    <div class="events-panel-head">
        <div>
            <h1 id="events-heading">@text.Heading</h1>
            <p>@text.Subheading</p>
        </div>
        @* Opens the "Create event" pop-up (_CreateEventDialog). *@
        <button class="cta-button events-create-button" type="button" data-open-event
                aria-haspopup="dialog">@text.CreateEvent.OpenButton</button>
    </div>

    @* My calendar is the default tab; Discover lists every event with the filter toolbar. *@
    <nav class="events-tabs" aria-label="@text.LabelEventsView">
        @foreach (var (value, label) in EventsViewModel.views)
        {
            <a asp-action="Index" asp-all-route-data="@Model.RouteValues(view: value)"
               aria-current="@(Model.View == value ? "page" : null)">@EventsText.Pick(text.Views, value, label)</a>
        }
    </nav>

    @if (Model.View == EventsViewModel.DISCOVER)
    {
        @* One toolbar of dropdowns: which events (status) and the filters on the left, the sort on the right.
           A dropdown that differs from its default gets "is-active" so it stands out.
           Plain GET form. The field names match EventsQuery. events.js submits it when a dropdown changes;
           the Apply button appears only when JavaScript is off. No search box: the header search covers the site. *@
        <form class="events-filter-bar" method="get" asp-action="Index" data-events-filters>
            <input type="hidden" name="view" value="@Model.View" />
            <div class="events-filters">
                <label>
                    <span class="visually-hidden">@text.LabelMyEvents</span>
                    <select name="status" class="@(Model.Status == EventsViewModel.DEFAULTSTATUS ? null : "is-active")">
                        @foreach (var (value, label) in EventsViewModel.statuses)
                        {
                            <option value="@value" selected="@(value == Model.Status)">@EventsText.Pick(text.Statuses, value, label)</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="visually-hidden">@text.LabelCommunity</span>
                    <select name="community" class="@(Model.Community is null ? null : "is-active")">
                        <option value="">@text.AllCommunities</option>
                        @foreach (var community in Model.Communities)
                        {
                            <option value="@community" selected="@(community == Model.Community)">@community</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="visually-hidden">@text.LabelCampus</span>
                    <select name="campus" class="@(Model.Campus is null ? null : "is-active")">
                        <option value="">@text.AllCampuses</option>
                        @foreach (var campus in EventsViewModel.campuses)
                        {
                            <option value="@campus" selected="@(campus == Model.Campus)">@campus</option>
                        }
                    </select>
                </label>
                <label>
                    <span class="visually-hidden">@text.LabelRange</span>
                    <select name="range" class="@(Model.Range == EventsViewModel.DEFAULTRANGE ? null : "is-active")">
                        @foreach (var (value, label) in EventsViewModel.ranges)
                        {
                            <option value="@value" selected="@(value == Model.Range)">@EventsText.Pick(text.Ranges, value,
                                                                                                                                                        label)</option>
                            }
                        </select>
                    </label>
                    <label>
                        <span class="visually-hidden">@text.LabelSort</span>
                        <select name="sort">
                            @foreach (var (value, label) in EventsViewModel.sorts)
                            {
                                <option value="@value" selected="@(value == Model.Sort)">@EventsText.Format(text.SortOption,
                                                                                                                                                                        EventsText.Pick(text.Sorts, value, label))</option>
                                }
                            </select>
                        </label>
                        <noscript><button class="primary-button" type="submit">@text.Apply</button></noscript>
                    </form>
                </div>

                @* The calendar shows RSVP events; Discover shows event cards. *@
                @if (Model.View == EventsViewModel.CALENDAR)
                {
                    <partial name="_Calendar" model="Model" />
                }
                else if (Model.Events.Count == 0)
                {
                    <div class="empty-state">
                        <p>@text.EmptyEvents</p>
                    </div>
                }
                else
                {
                    <ul class="event-grid">
                        @foreach (var item in Model.Events)
                        {
                            <li>
                                <partial name="_EventCard" model="item" />
                            </li>
                        }
                    </select>
                </label>
            </div>
            <label class="events-sort">
                <span>@text.LabelSort</span>
                <select name="sort" class="@(Model.Sort == EventsViewModel.DEFAULTSORT ? null : "is-active")">
                    @foreach (var (value, label) in EventsViewModel.sorts)
                    {
                        <option value="@value" selected="@(value == Model.Sort)">@EventsText.Format(text.SortOption, EventsText.Pick(text.Sorts, value, label))</option>
                    }
                </select>
            </label>
            <noscript><button class="primary-button" type="submit">@text.Apply</button></noscript>
        </form>

        @* How many events match, and a way back to the defaults once any dropdown is changed. *@
        <div class="events-results">
            @if (Model.Events.Count > 0)
            {
                <p>@EventsText.Format(Model.Events.Count == 1 ? text.ResultCountOne : text.ResultCount, Model.Events.Count)</p>
            }
            @if (Model.ActiveFilterCount > 0)
            {
                <a class="filter-reset" asp-action="Index" asp-all-route-data="@Model.ResetRouteValues()">@text.ResetFilters</a>
            }
        </div>
    }

    @* The calendar shows RSVP events; Discover shows event cards. *@
    @if (Model.View == EventsViewModel.CALENDAR)
    {
        <partial name="_Calendar" model="Model" />
    }
    else if (Model.Events.Count == 0)
    {
        <div class="empty-state">
            <p>@text.EmptyEvents</p>
        </div>
    }
    else
    {
        <ul class="event-grid">
            @foreach (var item in Model.Events)
            {
                <li>
                    <partial name="_EventCard" model="item" />
                </li>
            }
        </ul>
    }
</section>

<partial name="_CreateEventDialog" model="Model" />

@section Scripts {
    <script src="~/js/events.js" asp-append-version="true" defer></script>
}
