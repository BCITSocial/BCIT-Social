@using System.Globalization
@using BCIT_Social.ViewModels
@model EventCardViewModel
@* One event card, built from one entry in wwwroot/content/events-text.json. A row is left out when its value is empty.
   Badge and button wording comes from EventsText, which Index.cshtml passes down in ViewData. *@
@{
    var culture = CultureInfo.InvariantCulture;
    var text = ViewData[nameof(EventsText)] as EventsText ?? new EventsText();
    var isDetails = ViewData["EventDetails"] is true;

    // Same-day events read "5:30 – 7:00 PM" (the first AM/PM is dropped when both match).
    // Multi-day events show the full date and time for both ends.
    var time = "";
    if (Model.StartsAt is { } start)
    {
        if (Model.EndsAt is { } end && end.Date == start.Date)
        {
            var samePeriod = (start.Hour < 12) == (end.Hour < 12);
            time = start.ToString(samePeriod ? "h:mm" : "h:mm tt", culture) + " – " + end.ToString("h:mm tt", culture);
        }
        else if (Model.EndsAt is { } until)
        {
            time = start.ToString("ddd, MMM d · h:mm tt", culture) + " – " + until.ToString("ddd, MMM d · h:mm tt", culture);
        }
        else
        {
            time = start.ToString("h:mm tt", culture);
        }
    }

    // "Location · Campus", skipping whichever part is empty.
    var where = string.Join(" · ", new[] { Model.Location, Model.Campus }.Where(s => !string.IsNullOrWhiteSpace(s)));

    // Text of the badge in the top-right corner of the cover. Null means no badge.
    // The CSS class comes from the state (status-going, ...); only the visible label comes from the text.
    var (statusClass, status) = Model.IsCancelled ? ("cancelled", text.BadgeCancelled) : Model.Rsvp switch
    {
        RsvpStatus.Going => ("going", text.BadgeGoing),
        RsvpStatus.Interested => ("interested", text.BadgeInterested),
        RsvpStatus.Hosting => ("hosting", text.BadgeHosting),
        _ => ((string?)null, (string?)null),
    };
    var interested = Model.Rsvp == RsvpStatus.Interested;
    var going = Model.Rsvp == RsvpStatus.Going;
}
@* Banner at the top of the card. With no image it shows a plain placeholder with a calendar icon. *@
<article class="event-card@(Model.IsCancelled ? " is-cancelled" : "")">
    
    @* Top to bottom: title, tags, host, time, location, description, attendees, buttons. *@
    <div class="event-body">
        
        <div class="event-title-row">
            
            <h3 class="event-title">
                @if (isDetails)
                {
                    @Model.Title
                }
                else
                {
                    <a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a>
                }
            </h3>
            
        </div>
        @if (Model.Tags.Count > 0)
        {
            <ul class="event-tags" aria-label="@text.LabelEventTags">
                @foreach (var tag in Model.Tags)
                {
                    <li>@tag</li>
                }
            </ul>
        }
        <dl class="event-meta">
            @if (Model.HostName.Length > 0)
            {
                <div class="event-host">
                    <dt class="visually-hidden">@text.LabelHost</dt>
                    <dd>
                        <partial name="_Icon" model='"people"' /><span>@Model.HostName</span>
                    </dd>
                </div>
                
            }
            @if (time.Length > 0)
            {
                <div class="event-time">
                    <dt class="visually-hidden">@text.LabelTime</dt>
                    <dd>
                        <partial name="_Icon" model='"clock"' /><span>@time</span>
                    </dd>
                </div>
            }
            @if (where.Length > 0)
            {
                <div class="event-where">
                    <dt class="visually-hidden">@text.LabelLocation</dt>
                    <dd>
                        <partial name="_Icon" model='"pin"' /><span>@where</span>
                    </dd>
                </div>
            }
        </dl>
        @if (Model.Description.Length > 0)
        {
            <p class="event-description">@Model.Description</p>
        }
        <div class="event-footer">
            @if (Model.Attendees.Count > 0 || Model.GoingCount > 0)
            {
                <div class="event-attendees">
                    <span class="avatar-stack" aria-hidden="true">
                        @foreach (var attendee in Model.Attendees.Take(3))
                        {
                            if (!string.IsNullOrWhiteSpace(attendee.PhotoUrl))
                            {
                                <img class="avatar" src="@attendee.PhotoUrl" alt="" />
                            }
                            else
                            {
                                <span class="avatar">@attendee.Initials</span>
                            }
                        }
                    </span>
                    @if (Model.GoingCount > 0)
                    {
                        <span class="going-count">@EventsText.Format(text.GoingCount, Model.GoingCount)</span>
                    }
                </div>
            }
            @* TODO(BE): these buttons stay disabled until the RSVP and event detail/manage endpoints exist. *@
            <div class="event-actions">
                @if (Model.IsOwner && !isDetails)
                {
                    <a class="action-button action-view" asp-action="Details" asp-route-id="@Model.Id">
                        <partial name="_Icon" model='"external"' />@text.ButtonViewEvent
                    </a>
                }
                @if (Model.Rsvp != RsvpStatus.Hosting || isDetails)
                {
                    <form method="post" asp-action="Rsvp" asp-route-id="@Model.Id" asp-route-going="false"
                          asp-route-fromDetails="@isDetails">
                        <button class="action-button action-interested@(interested ? " is-selected" : "")" type="submit"
                                aria-pressed="@(interested ? "true" : "false")"
                                disabled="@(User.Identity?.IsAuthenticated != true)">
                            <partial name="_Icon" model='"star"' />@text.ButtonInterested
                        </button>
                    </form>
                    <form method="post" asp-action="Rsvp" asp-route-id="@Model.Id" asp-route-going="true"
                          asp-route-fromDetails="@isDetails">
                        <button class="action-button action-going@(going ? " is-selected" : "")" type="submit"
                                aria-pressed="@(going ? "true" : "false")" disabled="@(User.Identity?.IsAuthenticated != true)">
                            <partial name="_Icon" model='"check"' />@text.ButtonGoing
                        </button>
                    </form>
                }
                @if (Model.IsOwner && !isDetails)
                {
                    <a class="action-button action-hosting" asp-action="Manage"
                       asp-route-id="@Model.Id">@text.ButtonManageEvent</a>
                }
            </div>
        </div>
    </div>
</article>
