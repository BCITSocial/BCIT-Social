@model string
@* Inline SVG icons chosen by name. They use currentColor, so CSS sets their color and size. *@
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    @switch (Model)
    {
        case "people":
            <circle cx="9" cy="8" r="3.2" /><path d="M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6" /><circle cx="17" cy="9" r="2.5" /><path d="M16 13.2c2.7.3 5 2.4 5 5.3" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" />
            break;
        case "pin":
            <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" />
            break;
        case "star":
            <path d="m12 3.5 2.7 5.5 6 .9-4.4 4.2 1 6-5.3-2.8-5.3 2.8 1-6L3.3 9.9l6-.9Z" />
            break;
        case "check":
            <path d="m5 12.5 4.5 4.5L19 7.5" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
    }
</svg>
