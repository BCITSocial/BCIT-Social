@*
frontend view for Communities page.
- author: jaspreet bath
*@

@model IEnumerable<BCIT_Social.ViewModels.CommunityViewModel>
@using System.IO
@using System.Text.Json
@using System.Security.Claims
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    Layout = "_HomeLayout";
    var jsonPath = System.IO.Path.Combine(Env.WebRootPath, "content", "communities-text.json");
    using var jsonDoc = JsonDocument.Parse(File.ReadAllText(jsonPath));
    var text = jsonDoc.RootElement;
    var featured = text.GetProperty("featured");
    var modal = text.GetProperty("createModal");
    var browseHeadingText = text.GetProperty("browseHeading").GetString();
    var defaultEmptyDesc = text.GetProperty("defaultDescription").GetString();
    var defaultCampusText = text.GetProperty("defaultCampus").GetString();
    var joinedBtnText = text.GetProperty("joinedLabel").GetString();
    ViewData["Title"] = text.GetProperty("pageTitle").GetString();

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var campusOptions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var c in modal.GetProperty("campusOptions").EnumerateArray())
    {
        campusOptions.Add(c.GetString()!);
    }

    var statusTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var s in modal.GetProperty("statusOptions").EnumerateArray())
    {
        var sVal = s.GetString();
        if (!string.IsNullOrWhiteSpace(sVal) && !sVal.Equals("None", StringComparison.OrdinalIgnoreCase))
        {
            statusTags.Add(sVal);
        }
    }

    var timeTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var t in modal.GetProperty("timeOptions").EnumerateArray())
    {
        var tVal = t.GetString();
        if (!string.IsNullOrWhiteSpace(tVal) && !tVal.Equals("None", StringComparison.OrdinalIgnoreCase))
        {
            timeTags.Add(tVal);
        }
    }
}

<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />

<div class="communities-wrapper">
    @* header *@
    <div class="communities-header">
        <div>
            <h1 class="communities-title" data-text="page-title">@text.GetProperty("pageTitle").GetString()</h1>
            <p class="communities-subtitle" data-text="page-subtitle">@text.GetProperty("pageSubtitle").GetString()</p>
        </div>
        <button type="button" id="open-create-modal" class="btn-create" data-text="create-button">
            @text.GetProperty("createButton").GetString()
        </button>
    </div>

    @* category pill *@
    <div id="category-pills" class="filter-pills">
        @{
            var isFirst = true;
            foreach (var category in text.GetProperty("categories").EnumerateArray())
            {
                <button type="button" class="filter-pill @(isFirst ? "active" : "")" data-category="@category.GetString()">
                    @category.GetString()
                </button>
                isFirst = false;
            }
        }
    </div>

    @* search bar *@
    <div class="search-bar-row">
        <input type="text" id="community-search" class="search-input"
               placeholder="@text.GetProperty("searchPlaceholder").GetString()" />
    </div>

    @* main juicy stuff here ;) *@
    <div class="communities-layout">
        <div>
            @* feature card (might delete later) *@
            <div class="featured-card">
                <div class="featured-header-row">
                    <div class="featured-label" data-text="featured-label">@featured.GetProperty("label").GetString()
                    </div>
                    <div class="category-badge" data-text="featured-tag">@featured.GetProperty("tag").GetString()</div>
                    <div class="category-badge status-badge" data-text="featured-status">
                        @featured.GetProperty("statusTag").GetString()</div>
                        <div class="category-badge time-badge" data-text="featured-time">
                            @featured.GetProperty("timeTag").GetString()</div>
                        </div>
                        <h2 class="featured-heading" data-text="featured-heading">@featured.GetProperty("heading").GetString()
                        </h2>
                        <p class="featured-desc" data-text="featured-desc">@featured.GetProperty("description").GetString()</p>
                    </div>

                    @* browse heading *@
                    <h2 id="browse-heading" class="section-heading" data-text="browse-heading"
                        data-base-text="@browseHeadingText">
                        @browseHeadingText (@(Model?.Count() ?? 0))
                    </h2>

                    @* browse grid *@
                    <div id="browse-grid" class="browse-grid">
                        @if (Model != null)
                        {
                            @foreach (var item in Model)
                            {
                                var rawTags = (item.Type ?? "")
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                                    .ToList();

                                @* returns first item *@
                                var location = rawTags.FirstOrDefault(t => campusOptions.Contains(t)) ?? defaultCampusText;

                                var isJoined = item.IsJoined
                                               || rawTags.Contains(featured.GetProperty("statusTag").GetString(), StringComparer.OrdinalIgnoreCase);

                                var descProp = item.GetType().GetProperty("Description");
                                var rawDesc = descProp?.GetValue(item)?.ToString();
                                var finalDesc = !string.IsNullOrWhiteSpace(rawDesc) ? rawDesc : defaultEmptyDesc;

                                <div class="community-card" data-name="@item.Name?.ToLower()" data-type="@item.Type?.ToLower()">
                                    <div>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="card-clickable-link">
                                            <h3 class="community-card-title">@item.Name</h3>
                                        </a>

                                        @* badges *@
                                        <div class="badge-row" style="flex-wrap: wrap;">
                                            @foreach (var rawTag in rawTags)
                                            {
                                                if (campusOptions.Contains(rawTag)) { continue; }

                                                var badgeClass = statusTags.Contains(rawTag) ? "status-badge"
                                                               : timeTags.Contains(rawTag) ? "time-badge"
                                                               : "";
                                                <span class="category-badge @badgeClass">@rawTag</span>
                                            }
                                        </div>

                                        @* member count and location (needs more work later) *@
                                        <div class="member-count">
                                            <span>@(item.MembersCount) @text.GetProperty("membersLabel").GetString()</span>
                                            <span>&bull;</span>
                                            <span>@location</span>
                                        </div>

                                        <p class="community-desc" data-text="default-desc">@finalDesc</p>
                                    </div>

                                    <div class="card-actions">
                                        @if (isJoined)
                                        {
                                            <span class="btn-joined">@joinedBtnText</span>
                                        }
                                        else
                                        {
                                            <form asp-action="Join" asp-route-id="@item.Id" method="get">
                                                <button type="submit" class="btn-join" data-text="join-btn">
                                                    @text.GetProperty("joinButton").GetString()
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* partial load of pop-up modal *@
        <partial name="_CreateCommunityModal" model="modal" />

        @section Scripts {
            <script src="~/js/communities.js" asp-append-version="true"></script>
        }