@*
frontend view for Communities page.
- Everything comes from CommunityIndexViewModel, which CommunityController builds.
- author: jaspreet bath
*@

@model BCIT_Social.ViewModels.CommunityIndexViewModel
@{
    Layout = "_HomeLayout";
    var text = Model.Text;
    var filters = text.Filters;
    var options = text.Options;
    ViewData["Title"] = text.PageTitle;
    var alertMessage = text.AlertMessage;
}

<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />

<div class="communities-wrapper">
    @* header *@
    <div class="communities-header">
        <div>
            <h1 class="communities-title">@text.PageTitle</h1>
            <p class="communities-subtitle">@text.PageSubtitle</p>
        </div>
        <p></p>
        @if (ViewBag.UserCommunityCount < 3)
        {
            <button type="button" id="open-create-modal" class="btn-create">@text.CreateButton</button>
        }
        else
        {
            
            <button type="button" class="btn-create" onclick='alert("@alertMessage");'>@text.CreateButton</button>
        }
    </div>

    @* search & filter dropdowns, communities.js hides cards that don't match. *@
    <form id="community-filters" class="community-filters" method="get" role="search" aria-label="@filters.Label">
        <label class="filter-search">
            <span class="visually-hidden">@filters.SearchLabel</span>
            <input type="search" id="community-search" class="search-input" autocomplete="off"
                   placeholder="@filters.SearchPlaceholder" />
        </label>

        <div class="filter-selects">
            <label>
                <span class="visually-hidden">@filters.TypeLabel</span>
                <select class="filter-select" data-filter="topics">
                    <option value="">@filters.AllTypes</option>
                    @foreach (var option in options.Topics)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>

            <label>
                <span class="visually-hidden">@filters.CampusLabel</span>
                <select class="filter-select" data-filter="campus">
                    <option value="">@filters.AllCampuses</option>
                    @foreach (var option in options.Campuses)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>

            <label>
                <span class="visually-hidden">@filters.StatusLabel</span>
                <select class="filter-select" data-filter="status">
                    <option value="">@filters.AnyStatus</option>
                    @foreach (var option in options.Statuses)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>

            <button type="reset" class="filter-clear">@filters.ClearButton</button>
        </div>
    </form>

    @* main juicy stuff here ;) *@
    <div class="communities-layout">
        <div>
            @* feature card (might delete later) *@
            <div class="featured-card">
                <div class="featured-header-row">
                    <div class="featured-label">@text.Featured.Label</div>
                    <div class="category-badge">@text.Featured.Tag</div>
                    <div class="category-badge status-badge">@text.Featured.StatusTag</div>
                    <div class="category-badge time-badge">@text.Featured.TimeTag</div>
                </div>
                <h2 class="featured-heading">@text.Featured.Heading</h2>
                <p class="featured-desc">@text.Featured.Description</p>
            </div>

            @* browse heading. communities.js updates the count as you filter. *@
            <h2 id="browse-heading" class="section-heading" data-base-text="@text.BrowseHeading">
                @text.BrowseHeading (@Model.Communities.Count)
            </h2>

            @* browse grid. *@
            <div id="browse-grid" class="browse-grid">
                @foreach (var item in Model.Communities)
                {
                    <div class="community-card" data-name="@item.Name" data-topics="@item.TopicsAttribute"
                         data-campus="@item.Location" data-status="@item.Status">
                        <div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="card-clickable-link">
                                <h3 class="community-card-title">@item.Name</h3>
                            </a>

                            @* badges *@
                            <div class="badge-row">
                                @foreach (var badge in item.Badges)
                                {
                                    <span class="category-badge @badge.CssClass">@badge.Text</span>
                                }
                            </div>

                            @* member count and location *@
                            <div class="member-count">
                                <span>@item.MemberCount @text.MembersLabel</span>
                                <span>&bull;</span>
                                <span>@item.Location</span>
                            </div>

                            <p class="community-desc">@item.Description</p>
                        </div>

                        <div class="card-actions">
                            @if (item.IsJoined)
                            {
                                <span class="btn-joined">@text.JoinedLabel</span>
                            }
                            else
                            {
                                <form asp-action="Join" asp-route-id="@item.Id" method="get">
                                    <button type="submit" class="btn-join">@text.JoinButton</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>

            <p id="browse-empty" class="browse-empty" hidden="@(Model.Communities.Count > 0)">@filters.EmptyMessage</p>
        </div>
    </div>
</div>

@* partial load of pop-up modal *@
<partial name="_CreateCommunityModal" model="Model.CreateForm" />

@section Scripts {
    <script src="~/js/communities.js" asp-append-version="true"></script>
    <script src="~/js/community-form.js" asp-append-version="true"></script>
}