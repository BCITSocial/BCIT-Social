@*
frontend view for Communities page.
- Everything comes from CommunityIndexViewModel, which CommunityController builds.
- Your communities show first, then "Browse communities" (3 cards, "See all" pages through the rest).
- author: jaspreet bath
*@

@model BCIT_Social.ViewModels.CommunityIndexViewModel
@{
    Layout = "_HomeLayout";
    var text = Model.Text;
    var filters = text.Filters;
    var options = text.Options;
    var yours = Model.YourCommunities;
    var browse = Model.BrowseCommunities;
    ViewData["Title"] = text.PageTitle;
    // Labels for _CommunityCard.
    ViewData["CommunitiesText"] = text;
}

<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />

<div class="communities-wrapper">
    @* header *@
    <div class="communities-header">
        <div>
            <h1 class="communities-title">@text.PageTitle</h1>
            <p class="communities-subtitle">@text.PageSubtitle</p>
        </div>
        <button type="button" class="btn-create" data-open-modal="create-community-modal">@text.CreateButton</button>
    </div>

    @* search (an icon until hovered/focused) & filter dropdowns. communities.js hides cards that don't match. *@
    <form id="community-filters" class="community-filters" method="get" role="search" aria-label="@filters.Label">
        <div class="filter-search">
            <label for="community-search" class="filter-search-icon" title="@filters.SearchLabel">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                <span class="visually-hidden">@filters.SearchLabel</span>
            </label>
            <input type="search" id="community-search" class="search-input" autocomplete="off"
                   placeholder="@filters.SearchPlaceholder" />
        </div>

        <div class="filter-selects">
            <label>
                <span class="visually-hidden">@filters.TypeLabel</span>
                <select class="filter-select" data-filter="topics">
                    <option value="">@filters.AllTypes</option>
                    <optgroup label="@filters.CategoriesGroup">
                        @foreach (var option in options.Categories)
                        {
                            <option value="@option">@option</option>
                        }
                    </optgroup>
                    <optgroup label="@filters.TagsGroup">
                        @foreach (var option in options.Tags)
                        {
                            <option value="@option">@option</option>
                        }
                    </optgroup>
                </select>
            </label>

            <label>
                <span class="visually-hidden">@filters.CampusLabel</span>
                <select class="filter-select" data-filter="campus">
                    <option value="">@filters.AllCampuses</option>
                    @foreach (var option in options.Campuses)
                    {
                        <option value="@option">@option</option>
                    }
                </select>
            </label>

            <button type="reset" class="filter-clear">@filters.ClearButton</button>
        </div>
    </form>

    @* your communities (joined), all of them *@
    @if (Model.IsSignedIn)
    {
        <section class="community-section" aria-labelledby="your-heading">
            <div class="community-section-header">
                <h2 id="your-heading" class="community-section-title">
                    @text.YourHeading <span id="your-count" class="section-count">@yours.Count</span>
                </h2>
            </div>

            <div id="your-grid" class="browse-grid">
                @foreach (var item in yours)
                {
                    <partial name="_CommunityCard" model="item" />
                }
            </div>

            <p id="your-empty" class="browse-empty" hidden="@(yours.Count > 0)"
               data-empty-none="@text.YourEmpty" data-empty-filtered="@filters.EmptyMessage">@text.YourEmpty</p>
        </section>
    }

    @* browse: 3 cards, then "See all" turns it into pages of 8 with a pager (communities.js) *@
    <section class="community-section" aria-labelledby="browse-heading">
        <div class="community-section-header">
            <h2 id="browse-heading" class="community-section-title">
                @text.BrowseHeading <span id="browse-count" class="section-count">@browse.Count</span>
            </h2>
            <button type="button" id="browse-toggle" class="link-action-btn" aria-expanded="false" aria-controls="browse-page"
                    data-see-all="@text.SeeAllButton" data-show-less="@text.ShowLessButton"
                    hidden="@(browse.Count <= text.BrowsePreviewCount)">@text.SeeAllButton</button>
        </div>

        <div id="browse-page" class="browse-page"
             data-preview-count="@text.BrowsePreviewCount" data-page-size="@text.BrowsePageSize">
            <div id="browse-grid" class="browse-grid">
                @foreach (var item in browse)
                {
                    <partial name="_CommunityCard" model="item" />
                }
            </div>

            <nav id="browse-pager" class="browse-pager" aria-label="@text.Pager.Label" hidden
                 data-prev="@text.Pager.Previous" data-next="@text.Pager.Next" data-end="@text.Pager.End"></nav>
        </div>

        <p id="browse-empty" class="browse-empty" hidden="@(browse.Count > 0)"
           data-empty-none="@text.BrowseNone" data-empty-filtered="@filters.EmptyMessage">@text.BrowseNone</p>
    </section>
</div>

@* pop-ups: create community, and "Are you sure?" for Leave *@
<partial name="_CreateCommunityModal" model="Model.CreateForm" />
<partial name="_ConfirmDialog" />

@section Scripts {
    <script src="~/js/community-actions.js" asp-append-version="true"></script>
    <script src="~/js/communities.js" asp-append-version="true"></script>
    <script src="~/js/community-form.js" asp-append-version="true"></script>
}
