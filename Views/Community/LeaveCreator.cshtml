@model BCIT_Social.ViewModels.CommunitiesLeaveCreatorModel

@{
    ViewData["Title"] = "Leave";
}

<h1>@ViewData["Title"]</h1>

<h3>Do you want to leave this Community?</h3>

<div>
    <h4>@Model.CommunityName</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CommunityName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CommunityName)
        </dd>
    </dl>
    @if (Model.MemberCount == 1)
    {
        @* PLACEHOLDER *@
        <p style="color:red;">This will delete your community.</p>
        <form asp-action="LeaveCreatorSolo">
            <input type="hidden" asp-for="Id" />
            <input type="submit" value="Leave" class="btn btn-primary" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    }
    else
    {
        <form asp-action="LeaveCreatorMulti">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CommunityName" />
            <input type="hidden" asp-for="MemberCount" />
            <input type="hidden" asp-for="Members" />
            <p>Assign the new Owner of the Community.</p>
            <select asp-for="CreatorId">
                @foreach (var member in Model.Members)
                {
                    if (member.UserId != Model.CreatorId)
                    {
                        <option value="@member.UserId">@member.User.UserName</option>
                    }
                }
            </select>
            <input type="submit" value="Assign" class="btn btn-primary" />
            <p>Or Delete the Community.</p>
            <a asp-action="Index">Back to List</a>
        </form>
    }
</div>
