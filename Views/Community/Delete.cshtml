@*
- frontend view for Deleting a Community
- author: jaspreet bath
*@

@model BCIT_Social.ViewModels.CommunityDeleteViewModel

@{
    Layout = "_HomeLayout";
    var text = Model.Text;
    ViewData["Title"] = text.Title;
}

<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />

<div class="communities-wrapper">
    <div class="form-page-container">
        <div class="modal-card danger-card">
            <h1 class="modal-title danger-title">@text.Title</h1>
            <p class="modal-subtitle">@text.Subtitle</p>

            <div class="danger-box">
                <p>@text.WarningPrefix<strong>@Model.Name</strong>@text.WarningSuffix</p>
            </div>

            <div class="details-card delete-summary">
                <h3 class="delete-summary-title">@Model.Name</h3>
                <div class="badge-row">
                    @foreach (var badge in Model.Badges)
                    {
                        <span class="category-badge @badge.CssClass">@badge.Text</span>
                    }
                </div>
                <div class="member-count delete-summary-count">
                    <span>@Model.MemberCount @Model.MembersLabel</span>
                    <span>&bull;</span>
                    <span>@Model.Location</span>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="modal-footer-actions">
                    <a asp-action="Index" class="btn-cancel">@text.CancelButton</a>
                    <button type="submit" class="btn-danger-confirm">@text.ConfirmButton</button>
                </div>
            </form>
        </div>
    </div>
</div>