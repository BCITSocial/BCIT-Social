@*
- This is the frontend view for Editing a Community.
- author: jaspreet bath
*@

@model BCIT_Social.ViewModels.CommunityFormViewModel

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = Model.Text.Title;
}

<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />

<div class="communities-wrapper">
    <div class="form-page-container">
        <div class="modal-card">
            <h1 class="modal-title">@Model.Text.Title</h1>
            <p class="modal-subtitle">@Model.Text.Subtitle</p>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" data-community-form>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="text-danger form-errors"></div>
                }

                <partial name="_CommunityFormFields" model="Model" />

                <div class="modal-footer-actions form-page-actions">
                    <a asp-action="Index" class="btn-cancel">@Model.Text.CancelButton</a>
                    <button type="submit" class="btn-create">@Model.Text.SubmitButton</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/community-form.js" asp-append-version="true"></script>
}