@model BCIT_Social.ViewModels.CommunityMembersViewModel

@{
    Layout = "_HomeLayout";
    ViewData["Title"] = $"Members - {Model.Name}";
    var detailsMembersUrl = Url.Action("Details", "Community", new { id = Model.Id }) + "#members";
}

<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/community-details.css" asp-append-version="true" />
<meta http-equiv="refresh" content="0;url=@detailsMembersUrl" />

<div class="details-wrapper">
    <div class="details-card">
        <h1 class="community-main-title">Members for @Model.Name</h1>
        <p class="about-text">Opening members in the community view...</p>
        <p>
            <a href="@detailsMembersUrl" class="btn-settings">Open members</a>
        </p>
    </div>
</div>

@section Scripts {
    <script>
        window.location.replace(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(detailsMembersUrl)));
    </script>
}
