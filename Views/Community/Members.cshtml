@model BCIT_Social.ViewModels.CommunityMembersViewModel

@{
    ViewData["Title"] = "Members";
}
<h3>Members for @Model.Name</h3>
<div>
    <hr />
    <h3>Admin</h3>
    @* Have a list of the moderators on top *@
    <table>
        <tbody>
            <tr>
                <th class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th class="col-sm-2">
                    Joined On
                </th>
                @if (Model.IsCreator) // Only Creator can edit/kick admin
                {
                    <th class="col-sm-2">Actions</th>
                }
            </tr>
            @{
                foreach (var member in Model.Members)
                {
                    if (member.IsModerator)
                    {
                        <tr>
                            <td>
                                @if (member.UserId == Model.CreatorId)
                                {
                                    <span>!!!</span>
                                }
                                <a asp-action="Profile">@member.User.UserName</a>
                            </td>
                            <td>@member.JoinedAt.Date.ToLongDateString()</td>
                            @if (Model.IsCreator && member.UserId != Model.CreatorId)
                            {
                                <td><a asp-action="Kick" asp-route-id="@member.User.Id">Kick</a>
                                    <a asp-action="Details" asp-route-id="@member.User.Id">Edit Mod</a>
                                </td>
                            }
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
    <h3>Members</h3>
    <table>
        <tbody>
            <tr>
                <th class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th class="col-sm-2">
                    Joined On
                </th>
                @if (Model.IsMod) // Only Creator can edit/kick admin
                {
                    <th class="col-sm-2">Actions</th>
                }
            </tr>
            @{
                foreach (var member in Model.Members)
                {
                    <tr>
                        <td><a asp-controller="Profile" asp-action="Details"
                                   asp-route-id="@member.User.Id">@member.User.UserName</a>
                        </td>
                        <td>@member.JoinedAt.Date.ToLongDateString()</td>
                        @if (Model.IsMod
                        && member.UserId != Model.CreatorId
                        && !Model.Moderators.Contains(member))
                        {
                            <td><a asp-action="Kick" asp-route-id="@member.CommunityId" asp-route-userid="@member.User.Id">Kick</a>
                                <a asp-action="Details" asp-route-id="@member.User.Id">Edit Mod</a>
                            </td>
                        }
                    </tr>
                }
            }
        </tbody>
    </table>


</div>