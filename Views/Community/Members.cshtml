@model BCIT_Social.ViewModels.CommunityMembersViewModel

@{
    ViewData["Title"] = $"Members · {Model.Name}";
}

<link rel="stylesheet" href="~/css/community-members.css" asp-append-version="true" />

<section class="community-members-page" aria-labelledby="community-members-title">
    <header class="community-members-header">
        <div>
            <h1 id="community-members-title">Members</h1>
            <p>@Model.Name</p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.Id">Back to community</a>
    </header>
    <div class="community-members-body">
        <partial name="_MemberList" model="Model" />
    </div>
</section>
