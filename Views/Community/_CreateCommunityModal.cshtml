@*
- Partial View: Create Community Pop-up Modal
- Used for the Communities page. Any button with data-open-modal="create-community-modal"
  opens it (community-actions.js).
- author: jaspreet bath
*@

@model BCIT_Social.ViewModels.CommunityFormViewModel

<dialog id="create-community-modal" class="community-dialog" aria-labelledby="modal-title">
    <div class="modal-card">
        <!-- Title & Close Button -->
        <div class="modal-top-bar">
            <h2 id="modal-title" class="modal-title">@Model.Text.Title</h2>
            <button type="button" class="modal-close-btn" data-close-modal aria-label="Close">&times;</button>
        </div>
        <p class="modal-subtitle">@Model.Text.Subtitle</p>

        <!-- Form posts to CommunityController.Create. The cover image picker is in _CommunityFormFields. -->
        <form asp-action="Create" method="post" enctype="multipart/form-data" data-community-form>
            <partial name="_CommunityFormFields" model="Model" />

            @if (!string.IsNullOrEmpty(Model.Text.HelperNote))
            {
                <p class="modal-helper-note">@Model.Text.HelperNote</p>
            }

            <!-- Modal Footer Buttons -->
            <div class="modal-footer-actions">
                <button type="reset" class="button button-secondary" data-close-modal>@Model.Text.CancelButton</button>
                <button type="submit" class="button button-primary">@Model.Text.SubmitButton</button>
            </div>
        </form>
    </div>
</dialog>