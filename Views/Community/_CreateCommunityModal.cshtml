@*
- Partial View: Create Community Pop-up Modal
- author: jaspreet bath
- Uses the same popup style as Create post (create-dialog in home.css); create-post.js opens and closes it.
  The wording comes from the "createModal" section of communities-text.json.
*@

@model System.Text.Json.JsonElement

<dialog class="create-dialog" id="create-community-dialog" aria-labelledby="create-community-title">
    <div class="create-dialog-top">
        <div>
            <h2 class="create-title" id="create-community-title">@Model.GetProperty("title").GetString()</h2>
            <p class="create-subtitle">@Model.GetProperty("subtitle").GetString()</p>
        </div>
        <button class="icon-button" type="button" data-close-create aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
    </div>

    <!-- Form posts to CommunityController.Create -->
    <form id="create-community-form" class="create-form" method="post" asp-area="" asp-controller="Community" asp-action="Create">
        <div class="create-form-body">
            <div class="create-field">
                <label for="Name">@Model.GetProperty("nameLabel").GetString()</label>
                <input type="text" id="Name" name="Name" required
                       placeholder="@Model.GetProperty("namePlaceholder").GetString()" />
            </div>

            <div class="create-field">
                <label for="Description">@Model.GetProperty("descriptionLabel").GetString()</label>
                <textarea id="Description" name="Description" rows="3"
                          placeholder="@Model.GetProperty("descriptionPlaceholder").GetString()"></textarea>
            </div>

            @{
                // Category and tag used to be two dropdowns; they are one list of tags now.
                var tagChoices = Model.GetProperty("categoryOptions").EnumerateArray()
                    .Concat(Model.GetProperty("tagOptions").EnumerateArray())
                    .Select(opt => opt.GetString()!)
                    .Where(opt => !opt.Equals("None", StringComparison.OrdinalIgnoreCase))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Select(opt => new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem(opt, opt));
            }
            <partial name="_TagPicker" model='new BCIT_Social.ViewModels.TagPickerViewModel { Id = "community-tags", Legend = "Tags", Options = tagChoices, Min = 1 }' />

            <div class="create-field">
                <label for="Campus">@Model.GetProperty("campusLabel").GetString()</label>
                <select id="Campus" name="Campus">
                    @foreach (var campus in Model.GetProperty("campusOptions").EnumerateArray())
                    {
                        <option value="@campus.GetString()">@campus.GetString()</option>
                    }
                </select>
            </div>

            <!-- communities.js merges the ticked tags and the campus into Community.Type -->
            <input type="hidden" id="combined-type-input" name="Type" value="" />

            <button class="attach-box" type="button" disabled>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="14" rx="1.5" /><circle cx="9" cy="10" r="1.6" /><path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5" /></svg>
                @Model.GetProperty("coverTitle").GetString()
                <span class="visually-hidden">(not available yet)</span>
            </button>

            <p class="create-help">@Model.GetProperty("helperNote").GetString()</p>
        </div>

        <div class="create-footer">
            <button class="secondary-button" type="button" data-close-create>
                @Model.GetProperty("cancelButton").GetString()
            </button>
            <button class="cta-button publish-button" type="submit">
                @Model.GetProperty("submitButton").GetString()
            </button>
        </div>
    </form>
</dialog>
