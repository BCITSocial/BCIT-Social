@model BCIT_Social.ViewModels.DetailsCommunityViewModel

@{
    var jsonPath = System.IO.Path.Combine(Env.WebRootPath, "content", "community-details-text.json");
    var jsonDoc = JsonDocument.Parse(File.ReadAllText(jsonPath));
    var text = jsonDoc.RootElement;

    var banner = text.GetProperty("banner");
    var meta = text.GetProperty("communityMeta");
    var discussionsSection = text.GetProperty("discussionsSection");

    ViewData["Title"] = Model?.Name ?? "Community Details";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var rawTags = (Model?.Type ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    var mainJsonPath = System.IO.Path.Combine(Env.WebRootPath, "content", "communities-text.json");
    using var mainJsonDoc = JsonDocument.Parse(File.ReadAllText(mainJsonPath));
    var mainText = mainJsonDoc.RootElement;
    var modal = mainText.GetProperty("createModal");

    var campusOptions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var c in modal.GetProperty("campusOptions").EnumerateArray())
    {
        campusOptions.Add(c.GetString()!);
    }

    var defaultCampus = meta.GetProperty("campus").GetString();
    var modelLocation = rawTags.FirstOrDefault(t => campusOptions.Contains(t)) ?? defaultCampus;

    var statusTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var s in modal.GetProperty("statusOptions").EnumerateArray())
    {
        var sVal = s.GetString();
        if (!string.IsNullOrWhiteSpace(sVal) && !sVal.Equals("None", StringComparison.OrdinalIgnoreCase))
        {
            statusTags.Add(sVal);
        }
    }

    var timeTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var t in modal.GetProperty("timeOptions").EnumerateArray())
    {
        var tVal = t.GetString();
        if (!string.IsNullOrWhiteSpace(tVal) && !tVal.Equals("None", StringComparison.OrdinalIgnoreCase))
        {
            timeTags.Add(tVal);
        }
    }

    var activeStatus = mainText.GetProperty("featured").GetProperty("statusTag").GetString();
    var isUserJoined = (Model?.Members != null && !string.IsNullOrEmpty(currentUserId) && Model.Members.Any(m => m.UserId ==
currentUserId))
                       || rawTags.Contains(activeStatus, StringComparer.OrdinalIgnoreCase);

    var seeAllText = discussionsSection.GetProperty("seeAllText").GetString();
    var showLessText = discussionsSection.GetProperty("showLessText").GetString();

    var defaultEmptyDesc = mainText.GetProperty("defaultDescription").GetString();
    var communityDesc = !string.IsNullOrWhiteSpace(Model?.Description) ? Model.Description : defaultEmptyDesc;
}

<h1>Details</h1>

<div>
    <h4>Community</h4>
    <hr />
    <dl class="row">
        @* <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatorId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatorId)
        </dd> *@
