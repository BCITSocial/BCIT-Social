@model BCIT_Social.ViewModels.CommunityDetailsViewModel
@*
- This is the frontend view for Community Details.
- author: jaspreet bath
*@

@using System.IO
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.Build.Framework
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    // Same shell as the other pages: site header, left nav, centred content.
    Layout = "_HomeLayout";
    // Members see this community highlighted under "Your communities" in the left nav instead of "Communities".
    if (Model?.IsMember == true)
    {
        ViewData["ActiveCommunityId"] = Model.Id;
        // The layout's create post popup posts into this community.
        ViewData["CreatePostCommunityId"] = Model.Id;
    }
    var jsonPath = System.IO.Path.Combine(Env.WebRootPath, "content", "community-details-text.json");
    var jsonDoc = JsonDocument.Parse(File.ReadAllText(jsonPath));
    var text = jsonDoc.RootElement;

    var banner = text.GetProperty("banner");
    var meta = text.GetProperty("communityMeta");
    var discussionsSection = text.GetProperty("discussionsSection");

    ViewData["Title"] = Model?.Name ?? "Community Details";

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var rawTags = (Model?.Type ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    var mainJsonPath = System.IO.Path.Combine(Env.WebRootPath, "content", "communities-text.json");
    using var mainJsonDoc = JsonDocument.Parse(File.ReadAllText(mainJsonPath));
    var mainText = mainJsonDoc.RootElement;
    var modal = mainText.GetProperty("createModal");

    var campusOptions = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var c in modal.GetProperty("campusOptions").EnumerateArray())
    {
        campusOptions.Add(c.GetString()!);
    }

    var defaultCampus = meta.GetProperty("campus").GetString();
    var modelLocation = rawTags.FirstOrDefault(t => campusOptions.Contains(t)) ?? defaultCampus;

    var statusTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var s in modal.GetProperty("statusOptions").EnumerateArray())
    {
        var sVal = s.GetString();
        if (!string.IsNullOrWhiteSpace(sVal) && !sVal.Equals("None", StringComparison.OrdinalIgnoreCase))
        {
            statusTags.Add(sVal);
        }
    }

    var timeTags = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    foreach (var t in modal.GetProperty("timeOptions").EnumerateArray())
    {
        var tVal = t.GetString();
        if (!string.IsNullOrWhiteSpace(tVal) && !tVal.Equals("None", StringComparison.OrdinalIgnoreCase))
        {
            timeTags.Add(tVal);
        }
    }

    var activeStatus = mainText.GetProperty("featured").GetProperty("statusTag").GetString();
    var isUserJoined = (Model?.Members != null && !string.IsNullOrEmpty(currentUserId) && Model.Members.Any(m => m.UserId ==
currentUserId))
                       || rawTags.Contains(activeStatus, StringComparer.OrdinalIgnoreCase);
    // The creator owns the community: their pill says Owner and they get no Leave button.
    // Model.Creator is the creator's username, the same value as User.Identity.Name.
    var isOwner = !string.IsNullOrEmpty(User.Identity?.Name)
                  && string.Equals(Model?.Creator, User.Identity.Name, StringComparison.OrdinalIgnoreCase);


    var defaultEmptyDesc = mainText.GetProperty("defaultDescription").GetString();
    var communityDesc = !string.IsNullOrWhiteSpace(Model?.Description) ? Model.Description : defaultEmptyDesc;
}

<!-- Include communities.css for shared modal styling and badges -->
<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/community-details.css" asp-append-version="true" />

<div class="details-wrapper">
    <!-- 1. Hero Banner -->
    <div class="details-hero-banner">
        <div>
            <div class="banner-pre">@banner.GetProperty("subtitle").GetString()</div>
            <h1>@banner.GetProperty("title").GetString()</h1>
            <p>@banner.GetProperty("caption").GetString()</p>
            <div class="banner-code">@banner.GetProperty("codeBadge").GetString()</div>
        </div>
        <div class="banner-solid-accent">BCIT</div>
    </div>

    <!-- 2. Community Header Meta -->
    <div class="details-meta-row">
        <div class="meta-left">
            <div class="community-icon-box">&lt;/&gt;</div>
            <div>
                <div class="title-line">
                    <h2 class="community-main-title">@Model?.Name</h2>
                    @if (isOwner)
                    {
                        <span class="pill-joined" data-text="owner-label">@meta.GetProperty("ownerLabel").GetString()</span>
                    }
                    else if (isUserJoined)
                    {
                        <span class="pill-joined"
                              data-text="joined-label">@meta.GetProperty("joinedLabel").GetString()</span>
                    }
                </div>
                <div class="meta-sub-row">
                    @foreach (var rawTag in rawTags)
                    {
                        if (campusOptions.Contains(rawTag)) { continue; }

                        var badgeClass = statusTags.Contains(rawTag) ? "status-badge"
                                       : timeTags.Contains(rawTag) ? "time-badge"
                                       : "";
                        <span class="category-badge @badgeClass">@rawTag</span>
                    }
                    @* Opens the Members tab below (community-tabs.js). Without JavaScript it goes to the old Members page. *@
                    <a class="members-link" asp-action="Members" asp-route-id="@Model?.Id" data-show-tab="members">
                    <span>@(Model?.Members?.Count ?? 0) @mainText.GetProperty("membersLabel").GetString()</span></a>
                    <span>&bull;</span>
                    <span>@modelLocation</span>
                </div>
            </div>
        </div>

        <div class="meta-right-actions">
            @if (Model?.IsMember ?? false)
            {
                @* Owners can't leave their own community. *@
                if (!isOwner)
                {
                    <a asp-action="Leave" asp-route-id="@Model?.Id" class="btn-settings">@meta.GetProperty("leaveButton").GetString()</a>
                }
                <button type="button" class="create-button" data-open-create="create-post-dialog">
                    @meta.GetProperty("createButton").GetString()
                </button>
            }
            else if (!isUserJoined)
            {
                <form asp-action="Join" asp-route-id="@Model?.Id" method="post" class="join-form">
                    <button type="submit" class="create-button">@meta.GetProperty("joinButton").GetString()</button>
                </form>
            }
            @if (Model?.IsMod ?? false)
            {   
                <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn-settings">
                    @meta.GetProperty("settingsButton").GetString()
                </a>
            }
        </div>
    </div>

    <!-- 3. Tabs: Overview (about + posts) and Members. community-tabs.js switches them. -->
    <div class="details-tabs" role="tablist" aria-label="Community sections">
        <button type="button" class="tab-link" role="tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true" data-tab="overview">
            @text.GetProperty("navTabs")[0].GetString()
        </button>
        <button type="button" class="tab-link" role="tab" id="tab-members" aria-controls="panel-members" aria-selected="false" data-tab="members" tabindex="-1">
            @text.GetProperty("navTabs")[1].GetString()
        </button>
    </div>

    <div class="details-tab-panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview">
        <!-- 4. About Card -->
        <div class="details-card">
            <h3 class="section-title" style="margin-bottom: 0.45rem;">@text.GetProperty("aboutHeading").GetString()</h3>
            <p style="font-size: 0.9rem; color: var(--text-secondary); margin: 0; line-height: 1.5;">
                @communityDesc
            </p>
        </div>

        <!-- 5. Latest Discussions -->
        <div class="discussions-section-container">
            <div class="section-header-row">
                <h3 class="section-title">@discussionsSection.GetProperty("title").GetString()</h3>
            </div>
            @* The community's real posts, as the same clickable cards as the Home feed. *@
            @if (Model!.Posts.Count == 0)
            {
                <p class="discussions-empty">No posts in this community yet.</p>
            }
            else
            {
                ViewData["PostReturnUrl"] = Url.Action("Details", "Community", new { id = Model.Id });
                <div class="feed-list">
                    <partial name="~/Views/Home/_PostCards.cshtml" model="Model.Posts" />
                </div>
            }
        </div>
    </div>

    @* Everyone in the community, moderators first. Kick and moderator changes stay on the Manage members page. *@
    <div class="details-tab-panel" role="tabpanel" id="panel-members" aria-labelledby="tab-members" hidden>
        <div class="details-card">
            <div class="section-header-row">
                <h3 class="section-title">@text.GetProperty("navTabs")[1].GetString() (@(Model?.Members?.Count ?? 0))</h3>
                @if (Model?.IsMod ?? false)
                {
                    <a class="link-action-btn" asp-action="Members" asp-route-id="@Model?.Id">Manage members</a>
                }
            </div>
            @if ((Model?.Members?.Count ?? 0) == 0)
            {
                <p class="discussions-empty">No members yet.</p>
            }
            else
            {
                <ul class="member-list">
                    @foreach (var member in Model!.Members.OrderByDescending(m => m.IsModerator).ThenBy(m => m.JoinedAt))
                    {
                        var memberName = member.User?.UserName ?? "Member";
                        var initials = memberName.Length >= 2 ? memberName[..2].ToUpperInvariant() : memberName.ToUpperInvariant();
                        <li class="member-row">
                            <span class="avatar-initials" aria-hidden="true">@initials</span>
                            <div class="member-info">
                                <a class="member-name" asp-controller="Profile" asp-action="Details" asp-route-id="@member.UserId">@memberName</a>
                                <span class="member-joined">Joined @member.JoinedAt.ToString("MMM d, yyyy")</span>
                            </div>
                            @if (member.IsModerator)
                            {
                                <span class="category-badge">Moderator</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>

<partial name="_PostDialog" />

@* The Create button opens the layout's create post popup, already set to this community. *@
@section Scripts {
    <script src="~/js/post-details.js" asp-append-version="true" defer></script>
    <script src="~/js/community-tabs.js" asp-append-version="true" defer></script>
}
