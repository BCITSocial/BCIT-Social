@model BCIT_Social.ViewModels.CommunityDetailsViewModel
@*
- This is the frontend view for Community Details.
- Everything comes from CommunityDetailsViewModel.
- author: jaspreet bath
*@

@{
    var text = Model.Text;
    var meta = text.Meta;
    var discussions = text.Discussions;
    ViewData["Title"] = Model.Name;
}

<!-- Included communities.css for shared modal styling and badges -->
<link rel="stylesheet" href="~/css/communities.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/community-details.css" asp-append-version="true" />

<div class="details-wrapper">
    <!-- Hero Banner -->
    <div class="details-hero-banner">
        <div>
            <div class="banner-pre">@text.Banner.Subtitle</div>
            <h1>@text.Banner.Title</h1>
            <p>@text.Banner.Caption</p>
            <div class="banner-code">@text.Banner.CodeBadge</div>
        </div>
        <div class="banner-solid-accent">BCIT</div>
    </div>

    <!-- Community Header -->
    <div class="details-meta-row">
        <div class="meta-left">
            <div class="community-icon-box">&lt;/&gt;</div>
            <div>
                <div class="title-line">
                    <h2 class="community-main-title">@Model.Name</h2>
                    @if (Model.IsMember)
                    {
                        <span class="pill-joined">@meta.JoinedLabel</span>
                    }
                    else
                    {
                        <form asp-action="Join" asp-route-id="@Model.Id" method="post" class="inline-join-form">
                            <button type="submit" class="btn-create btn-join-small">@meta.JoinButton</button>
                        </form>
                    }
                </div>
                <div class="meta-sub-row">
                    @foreach (var badge in Model.Badges)
                    {
                        <span class="category-badge @badge.CssClass">@badge.Text</span>
                    }
                    <span>@meta.Privacy</span>
                    <span>&bull;</span>
                    <a asp-action="Members" asp-route-id="@Model.Id">
                        <span>@Model.Members.Count @meta.MembersLabel</span>
                    </a>
                    <span>&bull;</span>
                    <span>@Model.Location</span>
                </div>
            </div>
        </div>

        <div class="meta-right-actions">
            @if (Model.IsMember)
            {
                <a asp-action="Leave" asp-route-id="@Model.Id" class="btn-settings">@meta.LeaveButton</a>
                @* modal trigger button instead of route link *@
                <button type="button" id="open-create-modal" class="btn-create">@meta.CreateButton</button>
            }
            @if (Model.IsMod)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-settings">@meta.SettingsButton</a>
            }
        </div>
    </div>

    <!-- Navigation Tabs (the first is active) -->
    <div class="details-tabs">
        @for (var i = 0; i < text.NavTabs.Count; i++)
        {
            <button type="button" class="tab-link @(i == 0 ? "active" : "")">@text.NavTabs[i]</button>
        }
    </div>

    <!-- About Card -->
    <div class="details-card">
        <h3 class="section-title about-heading">@text.AboutHeading</h3>
        <p class="about-text">@Model.About</p>
    </div>

    <!-- Latest Discussions (placeholder content from the JSON) -->
    <div class="discussions-section-container">
        <div class="section-header-row">
            <h3 class="section-title">@discussions.Title</h3>
            <button type="button" id="toggle-discussions-btn" class="link-action-btn"
                    data-see-all="@discussions.SeeAllText" data-show-less="@discussions.ShowLessText">
                @discussions.SeeAllText
            </button>
        </div>
        <div id="discussions-list" class="discussions-list">
            @for (var i = 0; i < discussions.Items.Count; i++)
            {
                var discussion = discussions.Items[i];
                var isHiddenByDefault = i >= discussions.InitiallyShown;
                <div class="discussion-card @(isHiddenByDefault ? "discussion-extra is-hidden" : "")">
                    <div class="avatar-initials">@discussion.Initials</div>
                    <div class="discussion-content">
                        <div class="discussion-top-row">
                            <h4 class="discussion-title">@discussion.Title</h4>
                            <span class="discussion-time">@discussion.Time</span>
                        </div>
                        <p>@discussion.Body</p>
                        <div class="discussion-footer">
                            <span>@discussion.AuthorMeta</span>
                            <span>@discussion.RepliesCount</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Modular Modal Partial Inclusion -->
<partial name="_CreateCommunityModal" model="Model.CreateForm" />

@section Scripts {
    <!-- communities.js opens and closes the modal.
         community-form.js fills in its tags -->
    <script src="~/js/communities.js" asp-append-version="true"></script>
    <script src="~/js/community-form.js" asp-append-version="true"></script>
    <script src="~/js/community-details.js" asp-append-version="true"></script>
}