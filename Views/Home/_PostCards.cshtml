@model IReadOnlyList<BCIT_Social.ViewModels.PostCardViewModel>
@* Renders feed cards. Used by the first page and by /Home/Feed when more posts load on scroll. *@
@{
    var now = DateTime.UtcNow;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var returnUrl = ViewData["PostReturnUrl"] as string ?? "/";
}
@foreach (BCIT_Social.ViewModels.PostCardViewModel post in Model)
{
    <article class="post-card" data-post-id="@post.Id" data-created-ticks="@post.CreatedAt.Ticks" aria-labelledby="post-title-@post.Id">
        @if (post.AuthorId.Length > 0)
        {
            @* Opens the author's popout: profile link and a quick "Message" box. *@
            <button class="post-avatar user-trigger" type="button" data-user-popout data-user-id="@post.AuthorId"
                    data-user-name="@post.AuthorName" aria-label="Open @post.AuthorName's profile card">@post.AuthorInitials</button>
        }
        else
        {
            <div class="post-avatar" aria-hidden="true">@post.AuthorInitials</div>
        }
        <div class="post-body">
            <p class="post-meta">
                @if (post.AuthorId.Length > 0)
                {
                    <button class="post-author user-trigger user-trigger-text" type="button" data-user-popout
                            data-user-id="@post.AuthorId" data-user-name="@post.AuthorName">@post.AuthorName</button>
                }
                else
                {
                    <span class="post-author">@post.AuthorName</span>
                }
                @if (post.CommunityName is not null)
                {
                    <span>· @post.CommunityName</span>
                }
                <span>· <time datetime="@post.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">@post.TimeAgo(now)</time></span>
            </p>
            @if (post.Tags.Count > 0)
            {
                <ul class="post-tags" aria-label="Tags">
                    @foreach (var tag in post.Tags)
                    {
                        <li>@tag</li>
                    }
                </ul>
            }
            <h3 class="post-title" id="post-title-@post.Id">
                <a asp-controller="Home" asp-action="Post" asp-route-id="@post.Id" data-open-post>@post.Title</a>
            </h3>
            <p class="post-content">@post.Content</p>
            <div>
                @foreach (PostPhoto photo in post.Photos.OrderBy(photo => photo.DisplayOrder))
                {
                    <img src="@Url.Action("Photo", "Post", new { id = photo.Id })"
                            alt="@photo.OriginalFileName"
                            style="max-width: 100px; height: auto;" />
                }
            </div>  
            <div class="post-actions">
                <a class="post-action" asp-controller="Home" asp-action="Post" asp-route-id="@post.Id" data-open-post>
                    <svg class="post-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4Z" /></svg>
                    @post.CommentCount<span class="visually-hidden"> @(post.CommentCount == 1 ? "comment" : "comments")</span>
                </a>
              
                @if (signedIn)
                {
                    <form class="post-save" method="post" asp-controller="Bookmarks" asp-action="@(post.IsSaved ? "Remove" : "Save")" asp-route-postId="@post.Id" asp-route-returnUrl="@returnUrl">
                        <button class="post-action" type="submit" aria-pressed="@(post.IsSaved ? "true" : "false")">
                            <svg class="post-icon @(post.IsSaved ? "is-filled" : "")" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-6-4.5L6 21Z" /></svg>
                            @(post.IsSaved ? "Saved" : "Save")
                        </button>
                    </form>
                }
                else
                {
                    <a class="post-action post-save" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="/">
                        <svg class="post-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3h12v18l-6-4.5L6 21Z" /></svg>
                        Save<span class="visually-hidden"> (log in to save posts)</span>
                    </a>
                }
                @if (post.IsAuthor)
                {
                    <a class="post-action" asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
                    <form class="post-manage" method="post" asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" onsubmit="return confirm('Delete this post?');">
                        <button class="post-action" type="submit">Delete</button>
                    </form>
                }
            </div>
        </div>
    </article>
}
