@*
author: Andre Di Lascio, Asher
Renders the Home banner, share box, feed, and discovery panel.
*@

@using BCIT_Social.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    Layout = "_HomeLayout";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var homeUrl = Url.Action("Index", "Home");
    var loginUrl = Url.Page("/Account/Login", new { area = "Identity", returnUrl = homeUrl });
    var registerUrl = Url.Page("/Account/Register", new { area = "Identity", returnUrl = homeUrl });
}

<h1 class="visually-hidden">Home</h1>

@if (signedIn)
{
    <section class="panel home-section share-box" aria-labelledby="share-heading">
        <h2 id="share-heading" class="visually-hidden">Create a post</h2>
        <span class="avatar" aria-hidden="true">
            @if (Model.HasCurrentUserProfilePhoto && Model.CurrentUserId != null)
            {
                <img style="width: 100%; height: 100%; border-radius: inherit; object-fit: cover;"
                     src="@Url.Action("Photo", "Profile", new { id = Model.CurrentUserId })" />
            }
            else
            {
                <div>
                    @(Model.CurrentUserInitials == "" ? "?" : Model.CurrentUserInitials)
                </div>
            }
        </span>
        <a class="share-prompt" asp-controller="Post" asp-action="Create" data-open-create>What would you like to share?</a>
        <a class="cta-button" asp-controller="Post" asp-action="Create" data-open-create>Post</a>
        <p class="share-hint">Ask a question, find friends, or share an update.</p>
    </section>
}
else
{
    @* Signed-out visitors get a sign-up prompt here instead of the create post box. *@
    <section class="panel home-section share-box-guest" aria-labelledby="share-heading">
        <div class="share-guest-text">
            <h2 id="share-heading">Join the BCIT community</h2>
            <p>Sign up to post, comment, join communities, and connect with classmates.</p>
        </div>
        <div class="share-guest-actions">
            <a class="header-auth-button guest-login" href="@loginUrl">Log in</a>
            <a class="header-auth-button guest-signup" href="@registerUrl">Sign up</a>
        </div>
    </section>
}

<div class="home-feed-layout">
    <section class="panel home-section feed" aria-labelledby="feed-heading">
        @if (signedIn)
        {
            <div class="feed-heading">
                <h2 id="feed-heading">Your feed</h2>

                <nav class="feed-tabs" aria-label="Feed filter">
                    <a class="feed-tab @(Model.CurrentFilter == "all" ? "active" : "")" asp-controller="Home"
                       asp-action="Index" asp-route-filter="all" asp-route-tagId="@Model.CurrentTagId"
                       aria-current="@(Model.CurrentFilter == "all" ? "page" : null)">
                        All
                    </a>

                    <a class="feed-tab @(Model.CurrentFilter == "friends" ? "active" : "")" asp-controller="Home"
                       asp-action="Index" asp-route-filter="friends" asp-route-tagId="@Model.CurrentTagId"
                       aria-current="@(Model.CurrentFilter == "friends" ? "page" : null)">
                        Friends
                    </a>

                    <a class="feed-tab @(Model.CurrentFilter == "communities" ? "active" : "")" asp-controller="Home"
                       asp-action="Index" asp-route-filter="communities" asp-route-tagId="@Model.CurrentTagId"
                       aria-current="@(Model.CurrentFilter == "communities" ? "page" : null)">
                        Communities
                    </a>
                </nav>
            </div>
        }
        else
        {
            @* "Your feed" is for members. Guests still see posts, so the heading stays for screen readers only. *@
            <h2 id="feed-heading" class="visually-hidden">Posts</h2>
        }
        <form class="feed-tag-filter" asp-controller="Home" asp-action="Index" method="get">

            <input type="hidden" name="filter" value="@Model.CurrentFilter" />

            <label for="tagId">Filter by tag:</label>

            <select id="tagId" name="tagId" onchange="this.form.submit()">

                <option value="">All tags</option>

                @foreach (var tag in Model.AvailableTags)
                {
                    if (Model.CurrentTagId == tag.Id)
                    {
                        <option value="@tag.Id" selected>
                            @tag.Name
                        </option>
                    }
                    else
                    {
                        <option value="@tag.Id">
                            @tag.Name
                        </option>
                    }
                }
            </select>
        </form>
        @if (Model.Posts.Count == 0)
        {
            <div class="empty-state">
                <p>No posts yet. Be the first to share something.</p>
            </div>
        }
        else
        {
            <div class="feed-list" id="feed-list" data-feed-url="@Url.Action("Feed", "Home")"
                 data-has-more="@(Model.HasMore ? "true" : "false") data-filter=" @Model.CurrentFilter"
                 data-tag-id="@(Model.CurrentTagId?.ToString() ?? "")">
                <partial name="_PostCards" model="Model.Posts" />
            </div>
            <div class="feed-status">
                <p id="feed-status" role="status">@(Model.HasMore ? "" : "You're all caught up.")</p>
                <button class="primary-button" id="feed-retry" type="button" hidden>Try again</button>
            </div>
        }
    </section>
</div>

@* Nov 26th 4:45pm Joshua Trepanier: Removed the events thing in the top right deemed not needed
as it's not being used in the events page anymore with the calendar being implemented*@

@* Post details open here when a card is clicked. post-details.js fills the body from /Home/Post/{id}. *@
<dialog class="post-dialog" id="post-dialog" aria-labelledby="post-dialog-title">
    <div class="post-dialog-header">
        <h2 id="post-dialog-title">Post</h2>
        <button class="icon-button" type="button" data-close-dialog aria-label="Close post">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 6l12 12M18 6 6 18" />
            </svg>
        </button>
    </div>
    <div class="post-dialog-body" id="post-dialog-body"></div>
</dialog>

@section Scripts {
    <script src="~/js/feed.js" asp-append-version="true" defer></script>
    <script src="~/js/post-details.js" asp-append-version="true" defer></script>
}
