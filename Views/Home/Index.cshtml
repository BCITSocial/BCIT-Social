@*
author: Andre Di Lascio, Asher
Renders the Home banner, share box, feed, and discovery panel.
*@

@using BCIT_Social.ViewModels
@model HomeViewModel
@{
    ViewData["Title"] = "Home";
    Layout = "_HomeLayout";
    var signedIn = User.Identity?.IsAuthenticated == true;
    var homeUrl = Url.Action("Index", "Home");
    var loginUrl = Url.Page("/Account/Login", new { area = "Identity", returnUrl = homeUrl });
    var registerUrl = Url.Page("/Account/Register", new { area = "Identity", returnUrl = homeUrl });
}

<h1 class="visually-hidden">Home</h1>

@* The banner image and its sizing come from settings.css (--image-home-banner). *@
<section class="home-banner" role="img" aria-label="Your campus. Your people. Connect, share, and make the most of BCIT."></section>

@if (signedIn)
{
    <section class="panel home-section share-box" aria-labelledby="share-heading">
        <h2 id="share-heading" class="visually-hidden">Create a post</h2>
        <span class="avatar" aria-hidden="true">@(Model.CurrentUserInitials == "" ? "?" : Model.CurrentUserInitials)</span>
        <a class="share-prompt" asp-controller="Post" asp-action="Create" data-open-create>What would you like to share?</a>
        <a class="cta-button" asp-controller="Post" asp-action="Create" data-open-create>+ Create</a>
        <p class="share-hint">Ask a question, find friends, or share an update.</p>
    </section>
}
else
{
    @* Signed-out visitors get a sign-up prompt here instead of the create post box. *@
    <section class="panel home-section share-box-guest" aria-labelledby="share-heading">
        <div class="share-guest-text">
            <h2 id="share-heading">Join the BCIT community</h2>
            <p>Sign up to post, comment, join communities, and connect with classmates.</p>
        </div>
        <div class="share-guest-actions">
            <a class="header-auth-button guest-login" href="@loginUrl">Log in</a>
            <a class="header-auth-button guest-signup" href="@registerUrl">Sign up</a>
        </div>
    </section>
}

<div class="home-feed-layout">
<section class="panel home-section feed" aria-labelledby="feed-heading">
    <div class="feed-heading">
        @* "Your feed" is for members. Guests still see posts, so the heading stays for screen readers only. *@
        <h2 id="feed-heading" class="@(signedIn ? null : "visually-hidden")">@(signedIn ? "Your feed" : "Posts")</h2>
        @* Filter chips. Only "All" works for now: TODO(BE) HomeController.Index needs a filter parameter
           (campus, communities, friends) before the other chips can become links. *@
        <nav class="feed-filters" aria-label="Filter feed">
            <span class="feed-filter" aria-current="true">All</span>
            <button class="feed-filter" type="button" disabled title="Coming soon">Campus</button>
            <button class="feed-filter" type="button" disabled title="Coming soon">Communities</button>
            <button class="feed-filter" type="button" disabled title="Coming soon">Friends</button>
        </nav>
    </div>
    @if (Model.Posts.Count == 0)
    {
        <div class="empty-state">
            <p>No posts yet. Be the first to share something.</p>
        </div>
    }
    else
    {
        <div class="feed-list" id="feed-list" data-feed-url="@Url.Action("Feed", "Home")" data-has-more="@(Model.HasMore ? "true" : "false")">
            <partial name="_PostCards" model="Model.Posts" />
        </div>
        <div class="feed-status">
            <p id="feed-status" role="status">@(Model.HasMore ? "" : "You're all caught up.")</p>
            <button class="primary-button" id="feed-retry" type="button" hidden>Try again</button>
        </div>
    }
</section>
</div>

@* The Events/Communities box sits in the layout's right column, pinned to the right edge.
   Signed-out visitors get a call to action there instead. *@
@section RightPanel {
    @if (signedIn)
    {
        @* Upcoming events only. "Your communities" is already in the left nav, so there is no Communities tab. *@
        <aside class="panel home-section discovery-panel" aria-labelledby="discovery-heading">
            <h2 id="discovery-heading">Upcoming events</h2>
            <p class="discovery-empty">No upcoming events to show.</p>
            <a class="discovery-link" asp-controller="Events" asp-action="Index">View all events</a>
        </aside>
    }
    else
    {
        <aside class="panel home-section guest-cta-panel" aria-labelledby="guest-cta-heading">
            <h2 id="guest-cta-heading">Find your people</h2>
            <p>Make an account to RSVP to events, join communities, and message classmates.</p>
            <ul class="guest-cta-list">
                <li>Join clubs and program communities</li>
                <li>See what's happening on campus</li>
                <li>Chat with friends and classmates</li>
            </ul>
        </aside>
    }
}

<partial name="_PostDialog" />

@section Scripts {
    <script src="~/js/feed.js" asp-append-version="true" defer></script>
    <script src="~/js/post-details.js" asp-append-version="true" defer></script>
}
