@using Microsoft.IdentityModel.Tokens
@model BCIT_Social.ViewModels.PostDetailsViewModel
@* The post, its actions, the comment box, and comment threads. Shown in the Home modal and on /Home/Post/{id}. *@
@{
    var post = Model.Post;
    var now = DateTime.UtcNow;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var returnUrl = Url.Action("Post", "Home", new { id = post.Id });
    var paragraphs = post.Content.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    ViewData["PostId"] = post.Id;
    ViewData["ReturnUrl"] = returnUrl;
}
<article class="post-details" aria-labelledby="post-details-title">
    <div class="post-details-author">
        @if (!string.IsNullOrEmpty(post.AuthorId))
        {
            @* The avatar opens the author's popout: View profile and a quick "Message" box (user-popout.js). *@
            <button class="post-avatar user-trigger" type="button" data-user-popout data-user-id="@post.AuthorId"
                    data-user-name="@post.AuthorName" aria-label="Open @post.AuthorName's profile card">
                @if (post.AuthorHasProfilePhoto)
                {
                    <img class="post-avatar" style="width: 100%; height: 100%; border-radius: inherit; object-fit: cover;"
                         src="@Url.Action(action: "Photo", "Profile", new { id = post.AuthorId })" alt="" />
                }
                else
                {
                    <span aria-hidden="true">@post.AuthorInitials</span>
                }
            </button>
        }
        else
        {
            <span class="post-avatar" aria-hidden="true">@post.AuthorInitials</span>
        }
        <div>
            <a class="post-details-name" asp-controller="Profile" asp-action="Details"
               asp-route-userId="@post.AuthorId">@post.AuthorName</a>
            <p class="post-details-meta">
                @if (post.CommunityName is not null)
                {
                    <span>@post.CommunityName ·</span>
                }
                <time datetime="@post.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")">@post.TimeAgo(now)</time>
                @if (post.EditedAt is { } editedAt)
                {
                    <span class="post-edited">· <time datetime="@editedAt.ToString("yyyy-MM-ddTHH:mm:ssZ")"
                                                          title="Edited @BCIT_Social.ViewModels.DisplayFormat.TimeAgo(editedAt, now)">Edited</time></span>
                    }
                </p>
            </div>
        </div>

        <h3 class="post-details-title" id="post-details-title">@post.Title</h3>
        <div class="post-details-content">
            @foreach (var paragraph in paragraphs)
            {
                <p>@paragraph</p>
            }
        </div>
        <div id="details-photos" class="post-photo-holder">
            @foreach (PostPhoto photo in post.Photos.OrderBy(photo => photo.DisplayOrder))
            {
                <img class="post-details-photo" src="@Url.Action("Photo", "Post", new { id = photo.Id })"
                     alt="@photo.OriginalFileName" />
            }
        </div>
        @if (post.Tags.Count > 0)
        {
            <ul class="post-tags" aria-label="Tags">
                @foreach (var tag in post.Tags)
                {
                    <li>@tag</li>
                }
            </ul>
        }

        <div class="post-details-actions">
            @if (signedIn)
            {
                <form method="post" asp-controller="Bookmarks" asp-action="@(post.IsSaved ? "Remove" : "Save")"
                      asp-route-postId="@post.Id" asp-route-returnUrl="@returnUrl">
                    <button class="link-action" type="submit" aria-pressed="@(post.IsSaved ? "true" : "false")">
                        <svg class="post-icon @(post.IsSaved ? "is-filled" : "")" viewBox="0 0 24 24" aria-hidden="true"
                             focusable="false">
                            <path d="M6 3h12v18l-6-4.5L6 21Z" />
                        </svg>
                        @(post.IsSaved ? "Saved" : "Save")
                    </button>
                </form>
            }
            @if (post.IsAuthor)
            {
                <a class="link-action" asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id">Edit</a>
                <form method="post" asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id"
                      onsubmit="return confirm('Delete this post?');" data-delete-post>
                    <button class="link-action" type="submit">Delete</button>
                </form>
            }
            <button class="link-action share-action" type="button" data-share-url="@returnUrl"
                    data-share-title="@post.Title">
                <svg class="post-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
                </svg>
                Share
            </button>
            <span class="share-status" role="status"></span>
        </div>
    </article>

    <section class="comments" aria-labelledby="comments-heading-@post.Id">
        <h3 class="comments-heading" id="comments-heading-@post.Id">Comments (@post.CommentCount)</h3>

        <div class="comment-box">
            <div class="post-avatar" aria-hidden="true" asp-controller="Profile" asp-action="Details">
                @if (!Model.CurrentUserId.IsNullOrEmpty())
                {
                    <img class="post-avatar" style="width: 100%; height: 100%; border-radius: inherit; object-fit: cover;"
                         src="@Url.Action(action: "Photo", "Profile", new { id = Model.CurrentUserId })"
                         alt="@($"{@Model.CurrentUserId}'s profile photo")" />
                }
                else
                {
                    <span class="avatar" aria-hidden="true">@(Model.CurrentUserInitials == "" ? "?" :
                                                                    Model.CurrentUserInitials)</span>
                    }
                </div>
                @if (signedIn)
                {
                    <form class="comment-form" method="post" asp-controller="Comment" asp-action="Create"
                          asp-route-returnUrl="@returnUrl">
                        <input type="hidden" name="postId" value="@post.Id" />
                        <label class="visually-hidden" for="new-comment-@post.Id">Write a comment</label>
                        <input class="comment-input" id="new-comment-@post.Id" name="content" placeholder="Write a comment..."
                               autocomplete="off" maxlength="1000" required />
                        <button class="cta-button" type="submit">Comment</button>
                    </form>
                }
                else
                {
                    <a class="comment-input comment-login" asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@returnUrl">Log in to write a comment...</a>
                }
            </div>

            @if (Model.Comments.Count == 0)
            {
                <p class="comments-empty">No comments yet. Start the conversation.</p>
            }
            else
            {
                <ul class="comment-list">
                    @foreach (var comment in Model.Comments)
                    {
                        <partial name="_Comment" model="comment" view-data="ViewData" />
                    }
                </ul>
            }
        </section>

        <partial name="_BlankCommentDialog" />
