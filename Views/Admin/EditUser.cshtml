@model BCIT_Social.ViewModels.AdminUserViewModel
@{
    Layout = "_HomeLayout";
}
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<h1>Admin Dashboard</h1>
<a asp-action="Index">Back to dashboard</a>
<div class="card bg-light p-4 mt-2">
    @if (Model.AppUser.DateOfDel == null)
    {
        <h2>
            <a asp-controller="Profile" asp-action="Details" asp-route-id="@Model.AppUser.Id">User:
                @Model.AppUser.UserName</a>
            </h2>
        }
    else
        {
            <h2>User: @Model.AppUser.UserName</h2>
        }

        <hr />
        <p>Name: @Model.AppUser.FirstName @Model.AppUser.LastName</p>
        <p>Id: @Model.AppUser.Id</p>
        <p>Communities Owned</p>
        <ul>
            @foreach (var comm in Model.CommunitiesOwned)
            {
                <li>
                    <a asp-action="EditCommunity" asp-route-id="@comm.Id">@comm.Id: @comm.Name</a>
                </li>
            }
        </ul>
        <hr class="m-4" />
        <h3>Actions</h3>
        @if (Model.AppUser.DateOfDel != null)
        {
            var commsOwned = Model.CommunitiesOwned.Count == 0 ? "" : "disabled";
            <p class="text-danger">Date of Deletion: @Model.AppUser.DateOfDel</p>
            <form asp-action="RestoreUser" asp-route-id="@Model.AppUser.Id" method="post">
                <button type="submit">Restore User</button>
            </form>
            <strong class="text-danger mt-5">This will delete this user FOREVER</strong>
            if (commsOwned == "disabled")
            {
                <p>User must not own any communities.</p>
            }
            <form asp-action="PermaDeleteUser" asp-route-id="@Model.AppUser.Id" method="post">
                <button type="submit" class="bg-danger" @commsOwned>Permanently Delete User</button>
            </form>
        }
        else
        {
            <strong class="text-danger">This will mark all communities owned by user for deletion.</strong>
            <form asp-action="DeleteUser" asp-route-id="@Model.AppUser.Id" method="post">
                <button type="submit">Mark User For Deletion</button>
            </form>
        }
    </div>
