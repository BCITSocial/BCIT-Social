@using BCIT_Social.ViewModels
@model MessagesViewModel
@{
    ViewData["Title"] = "Messages";
    Layout = "_HomeLayout";
    var active = Model.Active;
    var showDetails = Model.ShowDetails && active is not null;
}

@* Messages page: conversation list, the open conversation, and (with ?details=true) a details panel on the right.
   On phones only one shows at a time: the list, the chat once a conversation is picked, or the details. *@
<link rel="stylesheet" href="~/css/messages.css" asp-append-version="true" />

@{
    // Photo when there is one, otherwise initials. The green dot marks people who are online.
    void Avatar(ConversationViewModel person, string size)
    {
        <span class="msg-avatar @size">
            @if (person.PhotoUrl is not null)
            {
                <img src="@person.PhotoUrl" alt="" />
            }
            else
            {
                <span aria-hidden="true">@person.Initials</span>
            }
            @if (person.IsOnline && size != "is-small")
            {
                <span class="msg-online-dot"><span class="visually-hidden">Online</span></span>
            }
        </span>
    }
}

<div class="messages-page@(Model.IsActiveChosen ? " is-chat-open" : null)@(showDetails ? " is-details-open" : null)" data-messages>
    <section class="msg-panel msg-list-panel" aria-labelledby="messages-heading">
        <div class="msg-list-head">
            <h1 id="messages-heading">Messages</h1>
            <button class="msg-primary-button" type="button" data-new-message>
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" /></svg>
                New message
            </button>
        </div>
        <label class="msg-search">
            <span class="visually-hidden">Search messages</span>
            <svg class="msg-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
            <input type="search" placeholder="Search messages" data-message-search />
        </label>
        <p class="visually-hidden" aria-live="polite" data-message-search-status></p>
        <nav class="msg-filters" aria-label="Filter conversations">
            @foreach (var (value, label) in MessagesViewModel.Filters)
            {
                <a asp-action="Index" asp-route-filter="@(value == "all" ? null : value)" aria-current="@(Model.Filter == value ? "page" : null)">@label</a>
            }
        </nav>

        @if (Model.Conversations.Count == 0)
        {
            <p class="msg-list-empty">@(Model.Filter == "unread" ? "You're all caught up." : "No conversations yet. Start one with New message.")</p>
        }
        else
        {
            <p class="msg-list-empty" hidden data-message-search-empty>No conversations match your search.</p>
            <ul class="msg-conversations">
                @foreach (var conversation in Model.Conversations)
                {
                    var last = conversation.LastMessage;
                    <li>
                        <a class="msg-conversation@(conversation.IsUnread ? " is-unread" : null)" data-conversation-id="@conversation.Id" asp-action="Index" asp-all-route-data="@Model.RouteValues(conversation: conversation.Id, details: false)" aria-current="@(conversation.Id == active?.Id ? "page" : null)">
                            @{ Avatar(conversation, "is-medium"); }
                            <span class="msg-conversation-text">
                                <span class="msg-conversation-top">
                                    <strong>@conversation.Name</strong>
                                    @if (last is not null)
                                    {
                                        <time datetime="@last.SentAt.ToString("s")">@MessagesViewModel.ListTime(last.SentAt)</time>
                                    }
                                </span>
                                <span class="msg-conversation-bottom">
                                    <span class="msg-preview">@(last is null ? "No messages yet" : (last.IsMine ? "You: " : "") + last.Text)</span>
                                    @if (conversation.IsUnread)
                                    {
                                        <span class="msg-unread-dot"><span class="visually-hidden">Unread</span></span>
                                    }
                                </span>
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
    </section>

    @if (active is null)
    {
        <section class="msg-panel msg-chat msg-chat-empty" aria-label="Conversation">
            <svg class="msg-empty-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4Z" /></svg>
            <p><strong>Your messages</strong></p>
            <p>Pick a conversation or start a new one.</p>
        </section>
    }
    else
    {
        var firstName = active.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? active.Name;
        <section class="msg-panel msg-chat" aria-labelledby="chat-name" data-conversation-id="@active.Id">
            <header class="msg-chat-head">
                <a class="msg-back icon-button" asp-action="Index" asp-route-filter="@(Model.Filter == "all" ? null : Model.Filter)" aria-label="Back to conversations">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7" /></svg>
                </a>
                @{ Avatar(active, "is-large"); }
                <div class="msg-chat-person">
                    <h2 id="chat-name">@active.Name</h2>
                    <p>
                        @active.Program
                        @if (active.IsOnline)
                        {
                            <span>· Active now</span>
                        }
                    </p>
                </div>
                <div class="msg-chat-actions">
                    <button class="icon-button" type="button" aria-label="Search in conversation" aria-controls="msg-chat-search" aria-expanded="false" data-conversation-search>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                    </button>
                    <button class="icon-button" type="button" aria-label="Start video call">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="6.5" width="12.5" height="11" rx="2" /><path d="m15.5 10.5 5-3v9l-5-3" /></svg>
                    </button>
                    <button class="icon-button" type="button" aria-label="More options">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="5" cy="12" r="1" /><circle cx="12" cy="12" r="1" /><circle cx="19" cy="12" r="1" /></svg>
                    </button>
                    @* Hidden while the panel is open, like the Figma frame; the panel has its own close button.
                       Without JavaScript the links reload the page with ?details=...; messages.js toggles the panel in place. *@
                    <a class="msg-details-button" asp-action="Index" asp-all-route-data="@Model.RouteValues(conversation: active.Id, details: true)" aria-controls="msg-details" data-details-open>
                        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" /><path d="M12 11v5M12 8h.01" /></svg>
                        <span>View details</span>
                    </a>
                </div>
            </header>

            @* Search in conversation: highlights matching messages. Shown by messages.js. *@
            <div class="msg-chat-search" id="msg-chat-search" hidden data-chat-search>
                <label class="msg-search">
                    <span class="visually-hidden">Search messages with @active.Name</span>
                    <svg class="msg-search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                    <input type="search" placeholder="Search in conversation" data-chat-search-input />
                </label>
                <span class="msg-chat-search-count" aria-live="polite" data-chat-search-count></span>
                <button class="icon-button" type="button" aria-label="Previous match" data-chat-search-step="-1">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 15 6-6 6 6" /></svg>
                </button>
                <button class="icon-button" type="button" aria-label="Next match" data-chat-search-step="1">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" /></svg>
                </button>
                <button class="icon-button" type="button" aria-label="Close search" data-chat-search-close>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </button>
            </div>

            @* column-reverse keeps the newest message in view when the page loads, without JavaScript. *@
            <div class="msg-scroll">
                <ol class="msg-log" role="log" aria-label="Messages with @active.Name">
                    @foreach (var day in active.Messages.GroupBy(message => message.SentAt.Date))
                    {
                        <li class="msg-day" data-day="@day.Key.ToString("yyyy-MM-dd")"><span>@MessagesViewModel.DayLabel(day.Key)</span></li>
                        @foreach (var message in day)
                        {
                            <li class="msg-row @(message.IsMine ? "is-mine" : "is-theirs")" data-message-id="@message.Id">
                                @if (!message.IsMine)
                                {
                                    Avatar(active, "is-small");
                                }
                                <div class="msg-bubble-group">
                                    <p class="msg-bubble"><span class="visually-hidden">@(message.IsMine ? "You" : active.Name): </span>@message.Text</p>
                                    <span class="msg-meta">
                                        <time datetime="@message.SentAt.ToString("s")">@message.SentAt.ToString("h:mm tt")</time>
                                        @if (message.IsMine && message.IsRead)
                                        {
                                            <svg class="msg-read" viewBox="0 0 24 24" role="img" aria-label="Read" focusable="false"><path d="m2.5 12.5 4 4 8-9M10.5 15.5l1 1 8-9" /></svg>
                                        }
                                    </span>
                                </div>
                            </li>
                        }
                    }
                    @* Always rendered (hidden when not typing) so new messages are inserted above it. *@
                    <li class="msg-row is-theirs msg-typing" hidden="@(!active.IsTyping)" data-typing>
                        @{ Avatar(active, "is-small"); }
                        <span class="msg-typing-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                        <span class="msg-typing-text">@firstName is typing...</span>
                    </li>
                </ol>
            </div>

            @* Copied by messages.js for new messages, so sent and received bubbles match the ones above. *@
            <template data-template="day">
                <li class="msg-day"><span></span></li>
            </template>
            <template data-template="mine">
                <li class="msg-row is-mine">
                    <div class="msg-bubble-group">
                        <p class="msg-bubble"><span class="visually-hidden">You: </span><span data-text></span></p>
                        <span class="msg-meta"><time></time></span>
                    </div>
                </li>
            </template>
            <template data-template="theirs">
                <li class="msg-row is-theirs">
                    @{ Avatar(active, "is-small"); }
                    <div class="msg-bubble-group">
                        <p class="msg-bubble"><span class="visually-hidden">@active.Name: </span><span data-text></span></p>
                        <span class="msg-meta"><time></time></span>
                    </div>
                </li>
            </template>

            @* messages.js adds sent messages on screen only; nothing is posted yet.
               TODO(BE): give the form an action that saves the message. *@
            <form class="msg-composer" method="post" data-message-form>
                <input type="hidden" name="conversationId" value="@active.Id" />
                <button class="icon-button" type="button" aria-label="Attach a file">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m20 11.5-8.2 8.2a5 5 0 0 1-7.1-7.1l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7l-8.5 8.5a1.7 1.7 0 0 1-2.4-2.4l7.8-7.8" /></svg>
                </button>
                <button class="icon-button" type="button" aria-label="Add an image">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="9.5" r="1.6" /><path d="m20.5 16-5-5-9 8.5" /></svg>
                </button>
                <button class="icon-button" type="button" aria-label="Add an emoji">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="8.5" /><path d="M8.5 14.5a4.5 4.5 0 0 0 7 0M9 9.5h.01M15 9.5h.01" /></svg>
                </button>
                <label class="msg-input">
                    <span class="visually-hidden">Message @active.Name</span>
                    <textarea name="text" rows="1" placeholder="Write a message..." required></textarea>
                </label>
                <button class="msg-send" type="submit" aria-label="Send message">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 3 10.5 13.5M21 3l-6.5 18-4-7.5L3 9.5Z" /></svg>
                </button>
            </form>
        </section>
    }

    @if (active is not null)
    {
        <aside class="msg-details" id="msg-details" aria-label="Details about @active.Name" hidden="@(!showDetails)" tabindex="-1">
            <section class="msg-panel msg-details-card msg-details-profile">
                <a class="msg-details-close icon-button" asp-action="Index" asp-all-route-data="@Model.RouteValues(conversation: active.Id, details: false)" aria-label="Close details" data-details-close>
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
                </a>
                @{ Avatar(active, "is-profile"); }
                <h2>@active.Name</h2>
                <p>@active.Program</p>
                @if (active.IsOnline)
                {
                    <p class="msg-details-status"><span class="msg-status-dot" aria-hidden="true"></span>Active now</p>
                }
                <a class="msg-outline-button" asp-controller="Profile" asp-action="Details" asp-route-userid="@active.UserId">View profile</a>
            </section>

            <section class="msg-panel msg-details-card" aria-labelledby="shared-communities-heading">
                <div class="msg-details-head">
                    <h2 id="shared-communities-heading">Shared communities</h2>
                    @if (active.SharedCommunities.Count > 2)
                    {
                        <a asp-controller="Community" asp-action="Index">See all</a>
                    }
                </div>
                @if (active.SharedCommunities.Count == 0)
                {
                    <p class="msg-details-empty">No communities in common yet.</p>
                }
                else
                {
                    <ul class="msg-details-list">
                        @foreach (var community in active.SharedCommunities.Take(2))
                        {
                            <li>
                                <a class="msg-community" asp-controller="Community" asp-action="Details" asp-route-id="@community.Id">
                                    <span class="msg-community-tile" aria-hidden="true">@community.Initials</span>
                                    <span class="msg-community-text">
                                        <strong>@community.Name</strong>
                                        <span>@DisplayFormat.Count(community.MemberCount) members</span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="msg-panel msg-details-card" aria-labelledby="shared-media-heading">
                <div class="msg-details-head">
                    <h2 id="shared-media-heading">Shared media</h2>
                    @if (active.SharedMedia.Count > 2)
                    {
                        <button class="msg-link-button" type="button" data-shared-media-all>See all</button>
                    }
                </div>
                @if (active.SharedMedia.Count == 0)
                {
                    <p class="msg-details-empty">Photos and files you share will appear here.</p>
                }
                else
                {
                    <ul class="msg-media-grid">
                        @foreach (var media in active.SharedMedia.Take(2))
                        {
                            <li>
                                <span class="msg-media-thumb">
                                    @if (media.ThumbnailUrl is not null)
                                    {
                                        <img src="@media.ThumbnailUrl" alt="" />
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 3.5h8l4 4v13H6Z" /><path d="M14 3.5v4h4" /></svg>
                                    }
                                </span>
                                <span class="msg-media-name">@media.FileName</span>
                                <time datetime="@media.SharedAt.ToString("s")">@media.SharedAt.ToString("MMM d, yyyy")</time>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="msg-panel msg-details-card" aria-labelledby="conversation-info-heading">
                <h2 id="conversation-info-heading">Conversation info</h2>
                <ul class="msg-details-list">
                    <li>
                        <button class="msg-info-row" type="button" data-conversation-search>
                            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
                            <span>Search in conversation</span>
                            <svg class="msg-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg>
                        </button>
                    </li>
                    <li>
                        @* messages.js toggles this on screen only. TODO(BE): save the mute setting. *@
                        <button class="msg-info-row" type="button" aria-pressed="@(active.IsMuted ? "true" : "false")" data-conversation-mute>
                            <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 16V11a6 6 0 0 1 12 0v5l1.5 2h-15Z" /><path d="M10 20.5a2 2 0 0 0 4 0" /></svg>
                            <span data-mute-label>@(active.IsMuted ? "Unmute notifications" : "Mute notifications")</span>
                            <svg class="msg-chevron" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6" /></svg>
                        </button>
                    </li>
                </ul>
            </section>
        </aside>
    }
</div>

@section Scripts {
    <script src="~/js/messages.js" asp-append-version="true" defer></script>
}
