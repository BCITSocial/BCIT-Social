@model BCIT_Social.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "Create Profile";
    Layout = "_HomeLayout";
}

<div class="profile-page-shell">
    <header class="profile-edit-heading">
        <div>
            <h1>Create profile</h1>
            <p>Introduce yourself to the BCIT community.</p>
        </div>
        <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
    </header>

<h4>Profile</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="DisplayName" class="control-label"></label>
                <input asp-for="DisplayName" class="form-control" />
                <span asp-validation-for="DisplayName" class="text-danger"></span>
            </div>

            <form asp-action="Create" method="post" class="profile-edit-form">
                <div asp-validation-summary="ModelOnly" class="profile-edit-validation" role="alert"></div>

                <div class="profile-edit-field">
                    <label asp-for="DisplayName"></label>
                    <input asp-for="DisplayName" autocomplete="name" />
                    <span asp-validation-for="DisplayName"></span>
                </div>

            <div class="form-group">
                <label asp-for="Campus" class="control-label"></label>
                <input asp-for="Campus" class="form-control" />
                <span asp-validation-for="Campus" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProfilePhoto">Profile photo</label>
                <input asp-for="ProfilePhoto" type="file" accept=".png,.jpg,.jpeg,.webp" />
                <span asp-validation-for="ProfilePhoto" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

                <div class="profile-edit-actions">
                    <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
                    <button class="profile-button profile-button-primary" type="submit">Create profile</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
