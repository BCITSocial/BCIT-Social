@*
Frontend for the profile page
Author: Jonathan Yeh
*@

@model BCIT_Social.Models.Profile

@{
    ViewData["Title"] = "My Profile";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="mb-1">My profile</h1>
        <p class="text-muted mb-0">Your introduction to the BCIT community.</p>
    </div>
    <a asp-action="Edit" class="btn btn-primary">Edit profile</a>
</div>

<section class="card shadow-sm" aria-labelledby="profile-heading">
    <div class="card-body p-4">
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center flex-shrink-0"
                 style="width: 4rem; height: 4rem;"
                 aria-hidden="true">
                <span class="text-muted">BCIT</span>
            </div>
            <div class="min-w-0">
                <h2 id="profile-heading" class="h4 mb-1 text-break">@Model.DisplayName</h2>
                <p class="text-muted mb-0">@Model.Program</p>
            </div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">About me</dt>
            <dd class="col-sm-9 text-break">
                @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added yet." : Model.Bio)
            </dd>

            <dt class="col-sm-3">Campus</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Campus) ? "Not specified" : Model.Campus)
            </dd>
        </dl>
    </div>
</section>
