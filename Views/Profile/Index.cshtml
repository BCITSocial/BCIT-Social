@*
Frontend for the profile page
Author: Jonathan Yeh
*@

@model IEnumerable<BCIT_Social.Models.Profile>

@{
    ViewData["Title"] = "My Profile";
    Layout = "_HomeLayout";

    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var profile = Model.FirstOrDefault(item => item.UserId == currentUserId);
    var displayName = profile?.DisplayName ?? "My profile";
    var avatarInitials = string.Concat(
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrWhiteSpace(avatarInitials))
    {
        avatarInitials = "B";
    }
}

<div class="profile-page" data-profile-user-id="@currentUserId">
    @if (profile == null)
    {
        <section class="profile-empty panel" aria-labelledby="profile-empty-heading">
            <h1 id="profile-empty-heading">Your profile</h1>
            <p>There is no profile associated with your signed-in account yet.</p>
            <a class="profile-button profile-button-primary" asp-action="Create">Create profile</a>
        </section>
    }
    else
    {
        <div class="profile-layout">
            <div class="profile-main-column">
                <section class="profile-card" aria-labelledby="profile-heading">
                    <div class="profile-cover" aria-hidden="true"></div>
                    <div class="profile-card-content">
                        <div class="profile-card-actions">
                            <div class="profile-avatar" aria-hidden="true">@avatarInitials</div>
                            <a class="profile-button profile-button-outline"
                               asp-controller="Profile"
                               asp-action="Edit"
                               asp-route-userid="@profile.UserId">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2Z" />
                                </svg>
                                Edit profile
                            </a>
                        </div>

                        <h1 id="profile-heading" class="profile-name">@profile.DisplayName</h1>

                        <div class="profile-tags" aria-label="Profile information">
                            @if (!string.IsNullOrWhiteSpace(profile.Program))
                            {
                                <span class="profile-tag">@profile.Program</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(profile.Campus))
                            {
                                <span class="profile-tag">@profile.Campus</span>
                            }
                        </div>

                        <p class="profile-bio" id="profile-about">
                            @(string.IsNullOrWhiteSpace(profile.Bio)
                                ? "Add a short introduction to tell the BCIT community about yourself."
                                : profile.Bio)
                        </p>

                        <div class="profile-stats" aria-label="Profile activity">
                            <span><strong>—</strong> Posts</span>
                            <span><strong>—</strong> Communities</span>
                            <span><strong>—</strong> Bookmarks</span>
                        </div>
                    </div>
                </section>

                <div class="profile-feed-toolbar">
                    <nav class="profile-tabs" aria-label="Profile sections">
                        <a class="profile-tab" href="#profile-posts" aria-current="page">Posts</a>
                        <a class="profile-tab" asp-controller="Community" asp-action="Index">Communities</a>
                        <a class="profile-tab" href="#profile-bookmarks">Bookmarks</a>
                        <a class="profile-tab" href="#profile-about">About</a>
                    </nav>

                </div>

                <section class="profile-posts" id="profile-posts" aria-labelledby="profile-posts-heading">
                    <h2 id="profile-posts-heading" class="visually-hidden">Posts</h2>
                    <div class="profile-empty-posts">
                        <div class="profile-empty-posts-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" focusable="false">
                                <path d="M5 4.5h14A1.5 1.5 0 0 1 20.5 6v10a1.5 1.5 0 0 1-1.5 1.5H9l-5.5 3v-3.2A1.5 1.5 0 0 1 3 16V6a1.5 1.5 0 0 1 2-1.5Z" />
                                <path d="M7 9h10M7 12.5h7" />
                            </svg>
                        </div>
                        <h3>No posts yet</h3>
                        <p>Share an update and start a conversation with your community.</p>
                        <a class="profile-button profile-button-primary"
                           asp-controller="Post"
                           asp-action="Create">Create a post</a>
                    </div>
                </section>


            </div>

            <aside class="profile-sidebar" aria-label="Profile information">
                <section class="profile-side-card profile-quick-info" aria-labelledby="profile-quick-info-heading">
                    <h2 id="profile-quick-info-heading">Quick info</h2>
                    <dl class="profile-info-list">
                        @if (!string.IsNullOrWhiteSpace(profile.Program))
                        {
                            <div>
                                <dt>
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M4 20V5h11v15M15 10h5v10M7 8h2m3 0h1M7 12h2m3 0h1M7 16h2m3 0h1m5-2h1m-1 3h1" />
                                    </svg>
                                    Program
                                </dt>
                                <dd>@profile.Program</dd>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(profile.Campus))
                        {
                            <div>
                                <dt>
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
                                        <circle cx="12" cy="10" r="2.2" />
                                    </svg>
                                    Campus
                                </dt>
                                <dd>@profile.Campus</dd>
                            </div>
                        }
                        @if (string.IsNullOrWhiteSpace(profile.Program) && string.IsNullOrWhiteSpace(profile.Campus))
                        {
                            <dd class="profile-info-empty">Add your program and campus to complete your profile.</dd>
                        }
                    </dl>
                </section>

                <section class="profile-side-card profile-quick-info" aria-labelledby="profile-quick-info-heading">
                    <div class="profile-themes" aria-labelledby="profile-themes-heading">
                        <h3 id="profile-themes-heading">Profile themes</h3>
                        <div class="profile-theme-options" role="group" aria-label="Choose a profile theme">
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="campus" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-campus" aria-hidden="true"></span>
                                Campus
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="ocean" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-ocean" aria-hidden="true"></span>
                                Ocean
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="forest" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-forest" aria-hidden="true"></span>
                                Forest
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="lavender" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-lavender" aria-hidden="true"></span>
                                Lavender
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="dark" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-dark" aria-hidden="true"></span>
                                Dark
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="colorblind" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-colorblind" aria-hidden="true"></span>
                                Red-green safe
                            </button>
                        </div>
                    </div>

                    <button class="profile-button profile-button-outline profile-customize-button"
                            type="button" data-open-profile-customizer>
                        Customize profile
                    </button>
                </section>

                <section class="profile-side-card profile-discover" aria-labelledby="profile-discover-heading">
                    <div class="profile-side-heading">
                        <h2 id="profile-discover-heading">Discover communities</h2>
                        <a asp-controller="Community" asp-action="Index">See all</a>
                    </div>
                    <p>Find student communities, meet people, and explore what’s happening at BCIT.</p>
                    <a class="profile-button profile-button-primary"
                       asp-controller="Community"
                       asp-action="Index">Browse communities</a>
                </section>
            </aside>
        </div>
    }
</div>

@if (profile != null)
{
    <dialog class="profile-customizer" data-profile-customizer aria-labelledby="profile-customizer-heading">
        <form class="profile-customizer-form" data-profile-customizer-form>
            <header class="profile-customizer-header">
                <div>
                    <h2 id="profile-customizer-heading">Customize your profile</h2>
                    <p>Personalize the look of your page and profile.</p>
                </div>
                <button class="profile-customizer-close" type="button" data-close-profile-customizer aria-label="Close customization">
                    <span aria-hidden="true">&times;</span>
                </button>
            </header>

            <div class="profile-customizer-fields">
                <div class="profile-customizer-field">
                    <label for="profile-accent-color">Page accent color</label>
                    <input id="profile-accent-color" name="accentColor" type="color" value="#173a63" />
                </div>
                <div class="profile-customizer-field">
                    <label for="profile-cover-style">Cover style</label>
                    <select id="profile-cover-style" name="coverStyle">
                        <option value="gradient">Soft gradient</option>
                        <option value="glow">Color glow</option>
                        <option value="stripes">Diagonal stripes</option>
                    </select>
                </div>
                <div class="profile-customizer-field">
                    <label for="profile-avatar-shape">Avatar shape</label>
                    <select id="profile-avatar-shape" name="avatarShape">
                        <option value="circle">Circle</option>
                        <option value="rounded">Rounded square</option>
                    </select>
                </div>
                <div class="profile-customizer-field">
                    <label for="profile-card-style">Card style</label>
                    <select id="profile-card-style" name="cardStyle">
                        <option value="standard">Standard</option>
                        <option value="lifted">Lifted</option>
                    </select>
                </div>
            </div>

            <p class="profile-customizer-status" data-profile-customizer-status role="status" aria-live="polite"></p>

            <footer class="profile-customizer-actions">
                <button class="profile-button profile-button-outline" type="button" data-reset-profile-customizer>
                    Reset
                </button>
                <div>
                    <button class="profile-button profile-button-outline" type="button" data-close-profile-customizer>
                        Cancel
                    </button>
                    <button class="profile-button profile-button-primary" type="submit">Save changes</button>
                </div>
            </footer>
        </form>
    </dialog>
}

@section Scripts {
    <script src="~/js/profile-customizer.js" asp-append-version="true" defer></script>
}
