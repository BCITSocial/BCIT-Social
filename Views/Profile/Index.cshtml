@*
Frontend for the profile page
Author: Jonathan Yeh
Last Revised: Nov 11, 2026
This view renders the user's profile page, including their profile information, posts, bookmarks, and communities
*@

@model BCIT_Social.ViewModels.ProfilePageViewModel
@using BCIT_Social.ViewModels

@{
    Layout = "_HomeLayout";

    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var profile = Model.Profile;
    ViewData["Title"] = profile?.DisplayName ?? "My Profile";
    var activeSection = Context.Request.Query["section"].ToString();
    if (activeSection is not ("communities" or "bookmarks" or "friends")
        || (!Model.IsOwnProfile && activeSection is ("bookmarks" or "friends")))
    {
        activeSection = "posts";
    }

    var displayName = profile?.DisplayName ?? "My profile";
    var avatarInitials = string.Concat(
        displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));

    if (string.IsNullOrWhiteSpace(avatarInitials))
    {
        avatarInitials = "B";
    }
}

<div class="profile-page" data-profile-user-id="@currentUserId">
    @if (profile == null)
    {
        <section class="profile-empty panel" aria-labelledby="profile-empty-heading">
            <h1 id="profile-empty-heading">Your profile</h1>
            <p>There is no profile associated with your signed-in account yet.</p>
            <a class="profile-button profile-button-primary" asp-action="Create">Create profile</a>
        </section>
    }
    else
    {
        <div class="profile-layout">
            <div class="profile-main-column">
                <section class="profile-card" aria-labelledby="profile-heading">
                    <div class="profile-cover" aria-hidden="true"></div>
                    <div class="profile-card-content">
                        <div class="profile-card-actions">
                            <div class="profile-avatar" aria-hidden="true">@avatarInitials</div>
                            @if (Model.IsOwnProfile)
                            {
                                <a class="profile-button profile-button-outline"
                                   asp-controller="Profile"
                                   asp-action="Edit"
                                   asp-route-userid="@profile.UserId">
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="m14 5 5 5M4 20l4.2-.8L19 8.4a2.1 2.1 0 0 0-3-3L5.2 16.2Z" />
                                    </svg>
                                    Edit profile
                                </a>
                                <button class="profile-button profile-button-outline profile-customize-button"
                                        type="button" data-open-profile-customizer>
                                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                        <path d="M12 3a9 9 0 1 0 0 18c1 0 1.5-.7 1.5-1.5 0-1.2-1-1.5-1-2.5s.8-1.5 1.8-1.5H17a4 4 0 0 0 4-4c0-4.7-4-8.5-9-8.5Z" />
                                        <circle cx="7.5" cy="11" r="1" /><circle cx="10" cy="7" r="1" /><circle cx="15" cy="7" r="1" />
                                    </svg>
                                    Customize
                                </button>
                            }
                            else if (Model.CanSendFriendRequest)
                            {
                                @if (TempData["FriendRequestMessage"] is string friendRequestMessage)
                                {
                                    <span class="profile-friend-inline-status" role="status">@friendRequestMessage</span>
                                }
                                else if (Model.FriendRelationshipStatus == "Accepted")
                                {
                                    <span class="profile-button profile-button-outline" aria-label="You are friends">Friends</span>
                                }
                                else if (Model.FriendRelationshipStatus == "PendingSent")
                                {
                                    <span class="profile-button profile-button-outline" aria-label="Friend request pending">Request sent</span>
                                }
                                else if (Model.FriendRelationshipStatus == "PendingReceived")
                                {
                                    <span class="profile-friend-inline-status">They sent you a request. Respond from your profile.</span>
                                }
                                else
                                {
                                    <form asp-action="AddFriend" method="post">
                                        <input type="hidden" name="userId" value="@profile.UserId" />
                                        <button class="profile-button profile-button-primary" type="submit">Add friend</button>
                                    </form>
                                }
                            }
                        </div>

                        <h1 id="profile-heading" class="profile-name">@profile.DisplayName</h1>

                        <div class="profile-tags" aria-label="Profile information">
                            @if (!string.IsNullOrWhiteSpace(profile.Program))
                            {
                                <span class="profile-tag">@profile.Program</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(profile.Campus))
                            {
                                <span class="profile-tag">@profile.Campus</span>
                            }
                        </div>

                        <p class="profile-bio">
                            @(string.IsNullOrWhiteSpace(profile.Bio)
                                ? "Add a short introduction to tell the BCIT community about yourself."
                                : profile.Bio)
                        </p>

                        <div class="profile-stats" aria-label="Profile activity">
                            <span><strong>@Model.Posts.Count</strong> Posts</span>
                            <span><strong>@Model.Communities.Count</strong> Communities</span>
                            @if (Model.IsOwnProfile)
                            {
                                <span><strong>@Model.Bookmarks.Count</strong> Bookmarks</span>
                            }
                        </div>
                    </div>
                </section>

                <div class="profile-feed-toolbar">
                    <nav class="profile-tabs" role="tablist" aria-label="Profile sections">
                        <button class="profile-tab" id="profile-posts-tab" type="button" role="tab"
                                aria-controls="profile-posts" aria-selected="@(activeSection == "posts")"
                                tabindex="@(activeSection == "posts" ? "0" : "-1")" data-profile-tab="posts">Posts</button>
                        <button class="profile-tab" id="profile-communities-tab" type="button" role="tab"
                                aria-controls="profile-communities" aria-selected="@(activeSection == "communities")"
                                tabindex="@(activeSection == "communities" ? "0" : "-1")" data-profile-tab="communities">Communities</button>
                        @if (Model.IsOwnProfile)
                        {
                            <button class="profile-tab" id="profile-friends-tab" type="button" role="tab"
                                    aria-controls="profile-friends" aria-selected="@(activeSection == "friends")"
                                    tabindex="@(activeSection == "friends" ? "0" : "-1")" data-profile-tab="friends">Friends (@Model.FriendCount)</button>
                            <button class="profile-tab" id="profile-bookmarks-tab" type="button" role="tab"
                                    aria-controls="profile-bookmarks" aria-selected="@(activeSection == "bookmarks")"
                                    tabindex="@(activeSection == "bookmarks" ? "0" : "-1")" data-profile-tab="bookmarks">Bookmarks</button>
                        }
                    </nav>
                </div>

                <section class="profile-posts" id="profile-posts" role="tabpanel"
                         aria-labelledby="profile-posts-tab" data-profile-panel="posts" hidden="@(activeSection != "posts")">
                    @if (Model.Posts.Count == 0)
                    {
                        <div class="profile-empty-posts">
                            <div class="profile-empty-posts-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" focusable="false">
                                    <path d="M5 4.5h14A1.5 1.5 0 0 1 20.5 6v10a1.5 1.5 0 0 1-1.5 1.5H9l-5.5 3v-3.2A1.5 1.5 0 0 1 3 16V6a1.5 1.5 0 0 1 2-1.5Z" />
                                    <path d="M7 9h10M7 12.5h7" />
                                </svg>
                            </div>
                            <h3>No posts yet</h3>
                            <p>Share an update and start a conversation with your community.</p>
                            <a class="profile-button profile-button-primary"
                               asp-controller="Post"
                               asp-action="Create">Create a post</a>
                        </div>
                    }
                    else
                    {
                        ViewData["PostReturnUrl"] = Url.Action("Index", "Profile", new { section = "posts" });
                        <div class="profile-post-list">
                            <partial name="~/Views/Home/_PostCards.cshtml" model="Model.Posts" />
                        </div>
                    }
                </section>

                <section class="profile-posts profile-content-panel" id="profile-communities" role="tabpanel"
                         aria-labelledby="profile-communities-tab" data-profile-panel="communities" hidden="@(activeSection != "communities")">
                    @if (Model.Communities.Count == 0)
                    {
                        <div class="profile-section-empty">
                            <h2>You haven’t joined any communities yet</h2>
                            <p>Find a community that shares your interests and meet other BCIT students.</p>
                            <a class="profile-button profile-button-primary"
                               asp-controller="Community" asp-action="Index">Explore communities</a>
                        </div>
                    }
                    else
                    {
                        <ul class="profile-community-list">
                            @foreach (var community in Model.Communities)
                            {
                                <li>
                                    <a class="profile-community-item" asp-controller="Community" asp-action="Details" asp-route-id="@community.Id">
                                        <span class="profile-community-avatar" aria-hidden="true">@community.Initials</span>
                                        <span class="profile-community-copy">
                                            <strong>@community.Name</strong>
                                            <span>@DisplayFormat.Count(community.MemberCount) @(community.MemberCount == 1 ? "member" : "members") · @community.Type</span>
                                        </span>
                                        <span class="profile-community-arrow" aria-hidden="true">›</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </section>

                @if (Model.IsOwnProfile)
                {
                    <section class="profile-posts profile-content-panel" id="profile-friends" role="tabpanel"
                             aria-labelledby="profile-friends-tab" data-profile-panel="friends" hidden="@(activeSection != "friends")">
                        @* Friend requests: moved here from the old right sidebar. *@
                        <div class="profile-friends-manage">
                            @if (TempData["FriendRequestMessage"] is string friendRequestMessage)
                            {
                                <p class="profile-friend-status" role="status">@friendRequestMessage</p>
                            }
                            @if (TempData["FriendRequestError"] is string friendRequestError)
                            {
                                <p class="profile-friend-status profile-friend-error" role="alert">@friendRequestError</p>
                            }

                            <form asp-action="SendFriendRequest" method="post" class="profile-friend-form">
                                <label for="friend-request-email">Send a friend request</label>
                                <input id="friend-request-email" name="Email" type="email" autocomplete="email"
                                       placeholder="person@example.com" required />
                                <button class="profile-button profile-button-primary" type="submit">Send request</button>
                            </form>

                            <div class="profile-incoming-requests">
                                <h3>Incoming requests (@Model.IncomingFriendRequests.Count)</h3>
                                @if (Model.IncomingFriendRequests.Count == 0)
                                {
                                    <p class="profile-info-empty">You don’t have any incoming requests.</p>
                                }
                                else
                                {
                                    <ul class="profile-friend-request-list">
                                        @foreach (var request in Model.IncomingFriendRequests)
                                        {
                                            <li class="profile-friend-request">
                                                <span class="profile-friend-request-name">@request.RequesterDisplayName</span>
                                                <div class="profile-friend-request-actions">
                                                    <form asp-action="RespondToFriendRequest" method="post">
                                                        <input type="hidden" name="requestId" value="@request.Id" />
                                                        <input type="hidden" name="decision" value="accept" />
                                                        <button class="profile-button profile-button-primary" type="submit">Accept</button>
                                                    </form>
                                                    <form asp-action="RespondToFriendRequest" method="post">
                                                        <input type="hidden" name="requestId" value="@request.Id" />
                                                        <input type="hidden" name="decision" value="deny" />
                                                        <button class="profile-button profile-button-outline" type="submit">Deny</button>
                                                    </form>
                                                </div>
                                            </li>
                                        }
                                    </ul>
                                }
                            </div>
                        </div>

                        @if (TempData["FriendListMessage"] is string friendListMessage)
                        {
                            <p class="profile-friend-status" role="status">@friendListMessage</p>
                        }
                        @if (Model.Friends.Count == 0)
                        {
                            <div class="profile-section-empty">
                                <h2>No friends yet</h2>
                                <p>When you accept a friend request, that person will appear here.</p>
                            </div>
                        }
                        else
                        {
                            <ul class="profile-community-list profile-friend-list">
                                @foreach (var friend in Model.Friends)
                                {
                                    <li class="profile-friend-list-item">
                                        <a class="profile-community-item profile-friend-profile-link"
                                           asp-action="Details"
                                           asp-route-userid="@friend.UserId">
                                            <span class="profile-community-avatar" aria-hidden="true">
                                                @string.Concat(friend.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])))
                                            </span>
                                            <span class="profile-community-copy">
                                                <strong>@friend.DisplayName</strong>
                                                <span>View profile</span>
                                            </span>
                                        </a>
                                        <form asp-action="RemoveFriend" method="post">
                                            <input type="hidden" name="relationshipId" value="@friend.RelationshipId" />
                                            <button class="profile-button profile-button-outline" type="submit">Remove friend</button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        }
                    </section>

                    <section class="profile-posts profile-content-panel" id="profile-bookmarks" role="tabpanel"
                             aria-labelledby="profile-bookmarks-tab" data-profile-panel="bookmarks" hidden="@(activeSection != "bookmarks")">
                        @if (Model.Bookmarks.Count == 0)
                        {
                            <div class="profile-bookmarks-empty">
                                <div class="profile-bookmarks-art" aria-hidden="true">
                                    <svg viewBox="0 0 64 64" focusable="false">
                                        <path d="M20 12h24a4 4 0 0 1 4 4v36L32 42l-16 10V16a4 4 0 0 1 4-4Z" />
                                        <path d="m49 10 1.5 4.5L55 16l-4.5 1.5L49 22l-1.5-4.5L43 16l4.5-1.5L49 10Z" />
                                        <path d="m13 24 1 3 3 1-3 1-1 3-1-3-3-1 3-1 1-3Z" />
                                    </svg>
                                </div>
                                <span class="profile-bookmarks-eyebrow">Your collection</span>
                                <h2>There’s no bookmarked post</h2>
                                <p>Save posts you love and they’ll be waiting for you here.</p>
                            </div>
                        }
                        else
                        {
                            ViewData["PostReturnUrl"] = Url.Action("Index", "Profile", new { section = "bookmarks" });
                            <div class="profile-post-list">
                                <partial name="~/Views/Home/_PostCards.cshtml" model="Model.Bookmarks" />
                            </div>
                        }
                    </section>
                }

            </div>
        </div>

        @* Owner only, inside .profile-page so profile-customizer.js and profile-theme.js find the theme buttons. *@
        @if (Model.IsOwnProfile)
        {
            <dialog class="profile-customizer" data-profile-customizer aria-labelledby="profile-customizer-heading">
                <form class="profile-customizer-form" data-profile-customizer-form>
                    <header class="profile-customizer-header">
                        <div>
                            <h2 id="profile-customizer-heading">Customize your profile</h2>
                            <p>Personalize the look of your page and profile.</p>
                        </div>
                        <button class="profile-customizer-close" type="button" data-close-profile-customizer aria-label="Close customization">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </header>

                    <div class="profile-themes" aria-labelledby="profile-themes-heading">
                        <h3 id="profile-themes-heading">Profile themes</h3>
                        <div class="profile-theme-options" role="group" aria-label="Choose a profile theme">
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="campus" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-campus" aria-hidden="true"></span>
                                Campus
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="ocean" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-ocean" aria-hidden="true"></span>
                                Ocean
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="forest" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-forest" aria-hidden="true"></span>
                                Forest
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="lavender" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-lavender" aria-hidden="true"></span>
                                Lavender
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="dark" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-dark" aria-hidden="true"></span>
                                Dark
                            </button>
                            <button class="profile-theme-option" type="button" data-profile-theme-choice="colorblind" aria-pressed="false">
                                <span class="profile-theme-swatch profile-theme-swatch-colorblind" aria-hidden="true"></span>
                                Red-green safe
                            </button>
                        </div>
                    </div>

                    <div class="profile-customizer-fields">
                        <div class="profile-customizer-field">
                            <label for="profile-accent-color">Page accent color</label>
                            <input id="profile-accent-color" name="accentColor" type="color" value="#173a63" />
                        </div>
                        <div class="profile-customizer-field">
                            <label for="profile-cover-style">Cover style</label>
                            <select id="profile-cover-style" name="coverStyle">
                                <option value="gradient">Soft gradient</option>
                                <option value="glow">Color glow</option>
                                <option value="stripes">Diagonal stripes</option>
                            </select>
                        </div>
                        <div class="profile-customizer-field">
                            <label for="profile-avatar-shape">Avatar shape</label>
                            <select id="profile-avatar-shape" name="avatarShape">
                                <option value="circle">Circle</option>
                                <option value="rounded">Rounded square</option>
                            </select>
                        </div>
                        <div class="profile-customizer-field">
                            <label for="profile-card-style">Card style</label>
                            <select id="profile-card-style" name="cardStyle">
                                <option value="standard">Standard</option>
                                <option value="lifted">Lifted</option>
                            </select>
                        </div>
                    </div>

                    <p class="profile-customizer-status" data-profile-customizer-status role="status" aria-live="polite"></p>

                    <footer class="profile-customizer-actions">
                        <button class="profile-button profile-button-outline" type="button" data-reset-profile-customizer>
                            Reset
                        </button>
                        <div>
                            <button class="profile-button profile-button-outline" type="button" data-close-profile-customizer>
                                Cancel
                            </button>
                            <button class="profile-button profile-button-primary" type="submit">Save changes</button>
                        </div>
                    </footer>
                </form>
            </dialog>
        }
    }
</div>


@section Scripts {
    <script src="~/js/profile-sections.js" asp-append-version="true" defer></script>
    <script src="~/js/profile-customizer.js" asp-append-version="true" defer></script>
    @* Makes the post cards clickable (they open the post page here, since there is no post modal). *@
    <script src="~/js/post-details.js" asp-append-version="true" defer></script>
}
