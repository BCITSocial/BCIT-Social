@model BCIT_Social.Models.Profile

@{
    ViewData["Title"] = "Delete Profile";
    Layout = "_HomeLayout";
}

<div class="profile-page-shell">
    <header class="profile-edit-heading">
        <div>
            <h1>Delete profile</h1>
            <p>This action will also delete the account associated with this profile.</p>
        </div>
        <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
    </header>

    <section class="profile-edit-card" aria-labelledby="profile-delete-heading">
        <div class="profile-edit-cover" aria-hidden="true"></div>
        <div class="profile-edit-content">
            <div class="profile-edit-section-heading">
                <div class="profile-avatar" aria-hidden="true">
                    @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "B" : Model.DisplayName[..1].ToUpperInvariant())
                </div>
                <div>
                    <h2 id="profile-delete-heading">Delete @Model.DisplayName’s profile?</h2>
                    <p>This cannot be undone.</p>
                </div>
            </div>

            <dl class="profile-detail-list">
                <div>
                    <dt>About me</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added yet." : Model.Bio)</dd>
                </div>
                <div>
                    <dt>Program</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Program) ? "Not specified" : Model.Program)</dd>
                </div>
                <div>
                    <dt>Campus</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Campus) ? "Not specified" : Model.Campus)</dd>
                </div>
            </dl>

            <form asp-action="Delete" asp-route-userid="@Model.UserId" method="post" class="profile-edit-actions">
                <input type="hidden" asp-for="UserId" />
                <a class="profile-button profile-button-outline" asp-action="Index">Keep profile</a>
                <button class="profile-button profile-button-danger" type="submit">Delete profile</button>
            </form>
        </div>
    </section>
</div>
