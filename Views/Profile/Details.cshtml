@model BCIT_Social.Models.Profile
@using System.Security.Claims

@{
    ViewData["Title"] = "Profile Details";
    Layout = "_HomeLayout";
}

<div class="profile-page-shell">
    <header class="profile-edit-heading">
        <div>
            <h1>Profile details</h1>
            <p>Get to know @Model.DisplayName.</p>
        </div>
        <a class="profile-button profile-button-outline" asp-action="Index">Back to profile</a>
    </header>

    <section class="profile-edit-card" aria-labelledby="profile-details-heading">
        <div class="profile-edit-cover" aria-hidden="true"></div>
        <div class="profile-edit-content">
            <div class="profile-edit-section-heading">
                <div class="profile-avatar" aria-hidden="true">
                    @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "B" : Model.DisplayName[..1].ToUpperInvariant())
                </div>
                <div>
                    <h2 id="profile-details-heading">@Model.DisplayName</h2>
                    <p>Profile information</p>
                </div>
            </div>

            <dl class="profile-detail-list">
                <div>
                    <dt>About me</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added yet." : Model.Bio)</dd>
                </div>
                <div>
                    <dt>Program</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Program) ? "Not specified" : Model.Program)</dd>
                </div>
                <div>
                    <dt>Campus</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Campus) ? "Not specified" : Model.Campus)</dd>
                </div>
            </dl>

            <div class="profile-edit-actions">
                <a class="profile-button profile-button-outline" asp-action="Index">Back to profile</a>
                <a class="profile-button profile-button-primary"
                   asp-action="Edit"
                   asp-route-userid="@Model.UserId">Edit profile</a>
                @if (User.Identity?.IsAuthenticated == true && Model.UserId != User.FindFirstValue(ClaimTypes.NameIdentifier))
                {
                    @* Opens (or creates) the direct chat with this person. *@
                    <form asp-controller="Messages" asp-action="MessageUser" method="post">
                        <input type="hidden" name="recipientId" value="@Model.UserId" />
                        <button class="profile-button profile-button-primary" type="submit">Message</button>
                    </form>
                }
            </div>
        </div>
    </section>
</div>