@{
    ViewData["Title"] = "Settings";
    Layout = "_HomeLayout";

    var userId = User.FindFirst(
        System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<section class="settings-page">
    <header class="settings-header">
        <div class="settings-heading">
            <h1>Settings</h1>
            <p>Manage your account details and profile preferences.</p>
        </div>

        <a class="settings-button settings-button-secondary"
           asp-controller="Profile"
           asp-action="Index">
            Back
        </a>
    </header>

    <main class="settings-content">
        <section class="settings-card"
                 aria-labelledby="email-settings-heading">
            <div class="settings-card-heading">
                <div>
                    <h2 id="email-settings-heading">Email address</h2>
                    <p class="settings-card-description">
                        Change the email address associated with your account.
                    </p>
                </div>
            </div>

            <div class="settings-form">
                <div class="settings-field">
                    <label for="new-email">New email address</label>
                    <input id="new-email"
                           name="newEmail"
                           type="email"
                           autocomplete="email"
                           placeholder="you@example.com"
                           disabled />
                </div>

                <button class="settings-button settings-button-primary"
                        type="button"
                        disabled>
                    Change email
                </button>
            </div>
        </section>

        <section class="settings-card"
                 aria-labelledby="password-settings-heading">
            <div class="settings-card-heading">
                <div>
                    <h2 id="password-settings-heading">Password</h2>
                    <p class="settings-card-description">
                        Update the password used to access your account.
                    </p>
                </div>
            </div>

            <div class="settings-form">
                <div class="settings-field">
                    <label for="current-password">Current password</label>
                    <input id="current-password"
                           name="currentPassword"
                           type="password"
                           autocomplete="current-password"
                           disabled />
                </div>

                <div class="settings-field">
                    <label for="new-password">New password</label>
                    <input id="new-password"
                           name="newPassword"
                           type="password"
                           autocomplete="new-password"
                           disabled />
                </div>

                <div class="settings-field">
                    <label for="confirm-password">Confirm new password</label>
                    <input id="confirm-password"
                           name="confirmPassword"
                           type="password"
                           autocomplete="new-password"
                           disabled />
                </div>

                <button class="settings-button settings-button-primary"
                        type="button"
                        disabled>
                    Change password
                </button>
            </div>
        </section>

        <section class="settings-card settings-danger-card"
                 aria-labelledby="delete-account-heading">
            <div class="settings-danger-copy">
                <h2 id="delete-account-heading">Delete account</h2>
                <p class="settings-card-description">
                    Permanently delete your profile and account. This action
                    cannot be undone.
                </p>
            </div>

            <a class="settings-button settings-button-danger"
               asp-controller="Profile"
               asp-action="Delete"
               asp-route-userid="@userId">
                Delete account
            </a>
        </section>
    </main>
</section>