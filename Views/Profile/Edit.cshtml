@model BCIT_Social.Models.Profile

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_HomeLayout";
}

<div class="profile-edit-page" data-profile-user-id="@Model.UserId">
    <header class="profile-edit-heading">
        <div>
            <h1>Edit profile</h1>
            <p>Update how you introduce yourself to the BCIT community.</p>
        </div>
        <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
    </header>

    <section class="profile-edit-card" aria-labelledby="profile-edit-details-heading">
        <div class="profile-edit-cover" aria-hidden="true"></div>
        <div class="profile-edit-content">
            <div class="profile-edit-section-heading">
                <div class="profile-avatar">
                    @if (!string.IsNullOrEmpty(Model.ProfilePhotoStorageKey))
                    {
                        <img style="width: 100%; height: 100%; border-radius: inherit; object-fit: cover;"
                            src="@Url.Action("Photo", "Profile", new { id = Model.UserId })"/>
                    }
                    else
                    {
                        @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "B" : Model.DisplayName[..1].ToUpperInvariant())
                    }
                </div>
                <div>
                    <h2 id="profile-edit-details-heading">Profile information</h2>
                    <p>Your profile helps other students get to know you.</p>
                </div>
            </div>

            <form asp-action="Edit" asp-route-userid="@Model.UserId" method="post" enctype="multipart/form-data" class="profile-edit-form">
                <div asp-validation-summary="ModelOnly" class="profile-edit-validation" role="alert"></div>
                <input type="hidden" asp-for="UserId" />

                <div class="profile-edit-field">
                    <label asp-for="DisplayName"></label>
                    <input asp-for="DisplayName" autocomplete="name" />
                    <span asp-validation-for="DisplayName"></span>
                </div>

                <div class="profile-edit-field">
                    <label asp-for="Bio">About me</label>
                    <textarea asp-for="Bio" rows="4" placeholder="Share a little about yourself..."></textarea>
                    <span asp-validation-for="Bio"></span>
                </div>

                <div class="profile-edit-fields-row">
                    <div class="profile-edit-field">
                        <label asp-for="Program"></label>
                        <input asp-for="Program" autocomplete="organization-title" />
                        <span asp-validation-for="Program"></span>
                    </div>

                    <div class="profile-edit-field">
                        <label asp-for="Campus"></label>
                        <select asp-for="Campus">
                            <option value="">Select a campus</option>
                            <option value="Burnaby">Burnaby</option>
                            <option value="Downtown">Downtown</option>
                            <option value="Marine">Marine</option>
                            <option value="Aerospace">Aerospace</option>
                        </select>
                        <span asp-validation-for="Campus"></span>
                    </div>
                </div>

                <div class="profile-edit-field">
                    <label for="ProfilePhoto">Profile photo</label>
                    <input id="ProfilePhoto" name="ProfilePhoto" type="file" accept=".png,.jpg,.jpeg,.webp" />
                    <span class="text-danger" data-valmsg-for="ProfilePhoto"></span>
                </div>

                <div class="profile-edit-actions">
                    <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
                    <button class="profile-button profile-button-primary" type="submit">Save changes</button>
                </div>
            </form>
        </div>
    </section>

    <section class="profile-edit-appearance" aria-labelledby="profile-edit-appearance-heading">
        <div class="profile-edit-appearance-copy">
            <h2 id="profile-edit-appearance-heading">Profile appearance</h2>
            <p>Choose a theme or customize your profile’s accent color.</p>
        </div>
        <div class="profile-theme-options" role="group" aria-label="Choose a profile theme">
            <button class="profile-theme-option" type="button" data-profile-theme-choice="campus" aria-pressed="false">
                <span class="profile-theme-swatch profile-theme-swatch-campus" aria-hidden="true"></span>
                Campus
            </button>
            <button class="profile-theme-option" type="button" data-profile-theme-choice="forest" aria-pressed="false">
                <span class="profile-theme-swatch profile-theme-swatch-forest" aria-hidden="true"></span>
                Forest
            </button>
            <button class="profile-theme-option" type="button" data-profile-theme-choice="lavender" aria-pressed="false">
                <span class="profile-theme-swatch profile-theme-swatch-lavender" aria-hidden="true"></span>
                Lavender
            </button>
            <button class="profile-theme-option" type="button" data-profile-theme-choice="dark" aria-pressed="false">
                <span class="profile-theme-swatch profile-theme-swatch-dark" aria-hidden="true"></span>
                Dark
            </button>
        </div>
        <button class="profile-button profile-button-outline profile-customize-button"
                type="button" data-open-profile-customizer>
            Customize profile
        </button>
    </section>

    <dialog class="profile-customizer" data-profile-customizer aria-labelledby="profile-customizer-heading">
        <form class="profile-customizer-form" data-profile-customizer-form>
            <header class="profile-customizer-header">
                <div>
                    <h2 id="profile-customizer-heading">Customize your profile</h2>
                    <p>Personalize the accent color used across your profile.</p>
                </div>
                <button class="profile-customizer-close" type="button" data-close-profile-customizer aria-label="Close customization">
                    <span aria-hidden="true">&times;</span>
                </button>
            </header>

            <div class="profile-customizer-fields">
                <div class="profile-customizer-field">
                    <label for="profile-accent-color">Page accent color</label>
                    <input id="profile-accent-color" name="accentColor" type="color" value="#173a63" />
                </div>
            </div>

            <p class="profile-customizer-status" data-profile-customizer-status role="status" aria-live="polite"></p>

            <footer class="profile-customizer-actions">
                <button class="profile-button profile-button-outline" type="button" data-reset-profile-customizer>
                    Reset
                </button>
                <div>
                    <button class="profile-button profile-button-outline" type="button" data-close-profile-customizer>
                        Cancel
                    </button>
                    <button class="profile-button profile-button-primary" type="submit">Save changes</button>
                </div>
            </footer>
        </form>
    </dialog>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/profile-customizer.js" asp-append-version="true" defer></script>
}
