@model BCIT_Social.Models.Profile

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_HomeLayout";
}

<div class="profile-edit-page">
    <header class="profile-edit-heading">
        <div>
            <h1>Edit profile</h1>
            <p>Update how you introduce yourself to the BCIT community.</p>
        </div>
        <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
    </header>

    <section class="profile-edit-card" aria-labelledby="profile-edit-details-heading">
        <div class="profile-edit-cover" aria-hidden="true"></div>
        <div class="profile-edit-content">
            <div class="profile-edit-section-heading">
                <div class="profile-avatar" aria-hidden="true">
                    @(string.IsNullOrWhiteSpace(Model.DisplayName) ? "B" : Model.DisplayName[..1].ToUpperInvariant())
                </div>
                <div>
                    <h2 id="profile-edit-details-heading">Profile information</h2>
                    <p>Your profile helps other students get to know you.</p>
                </div>
            </div>

            <form asp-action="Edit" asp-route-userid="@Model.UserId" method="post" class="profile-edit-form">
                <div asp-validation-summary="ModelOnly" class="profile-edit-validation" role="alert"></div>
                <input type="hidden" asp-for="UserId" />

                <div class="profile-edit-field">
                    <label asp-for="DisplayName"></label>
                    <input asp-for="DisplayName" autocomplete="name" />
                    <span asp-validation-for="DisplayName"></span>
                </div>

                <div class="profile-edit-field">
                    <label asp-for="Bio">About me</label>
                    <textarea asp-for="Bio" rows="4" placeholder="Share a little about yourself..."></textarea>
                    <span asp-validation-for="Bio"></span>
                </div>

                <div class="profile-edit-fields-row">
                    <div class="profile-edit-field">
                        <label asp-for="Program"></label>
                        <input asp-for="Program" autocomplete="organization-title" />
                        <span asp-validation-for="Program"></span>
                    </div>

                    <div class="profile-edit-field">
                        <label asp-for="Campus"></label>
                        <select asp-for="Campus">
                            <option value="">Select a campus</option>
                            <option value="Burnaby">Burnaby</option>
                            <option value="Downtown">Downtown</option>
                            <option value="Marine">Marine</option>
                            <option value="Aerospace">Aerospace</option>
                        </select>
                        <span asp-validation-for="Campus"></span>
                    </div>
                </div>

                <div class="profile-edit-actions">
                    <a class="profile-button profile-button-outline" asp-action="Index">Cancel</a>
                    <button class="profile-button profile-button-primary" type="submit">Save changes</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
