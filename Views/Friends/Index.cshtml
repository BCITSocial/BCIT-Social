@using BCIT_Social.ViewModels
@{
    Layout = "_HomeLayout";
    ViewData["Title"] = "Friends";
    var friends = ViewData["Friends"] as IReadOnlyList<FriendListItemViewModel> ?? Array.Empty<FriendListItemViewModel>();
    var incomingRequests = ViewData["IncomingFriendRequests"] as IReadOnlyList<IncomingFriendRequestViewModel> ?? Array.Empty<IncomingFriendRequestViewModel>();
    var sentRequests = ViewData["SentFriendRequests"] as IReadOnlyList<FriendListItemViewModel> ?? Array.Empty<FriendListItemViewModel>();
    var friendDetails = ViewData["FriendDetails"] as IReadOnlyDictionary<string, (string Program, string Campus)>;
    var query = ViewData["SearchQuery"] as string;
    var results = ViewData["SearchResults"] as IReadOnlyList<FriendSearchResultViewModel> ?? Array.Empty<FriendSearchResultViewModel>();
    string Initials(string name) => string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
<link rel="stylesheet" href="~/css/friends.css" asp-append-version="true" />
<section class="friends-page" aria-labelledby="friends-heading">
    <header class="friends-header">
        <h1 id="friends-heading">Friends <span class="friends-count friends-header-count" aria-label="@friends.Count @(friends.Count == 1 ? "friend" : "friends")">@friends.Count</span></h1>
    </header>

    @if (TempData["FriendListMessage"] is string listMessage)
    {
        <p class="friends-status" role="status">@listMessage</p>
    }
    @if (TempData["FriendRequestMessage"] is string message)
    {
        <p class="friends-status" role="status">@message</p>
    }
    @if (TempData["FriendRequestError"] is string error)
    {
        <p class="friends-status is-error" role="alert">@error</p>
    }

    <section class="friends-section friends-section-first" aria-labelledby="list-heading">
        <h2 id="list-heading" class="friends-sr-only">Your friends</h2>
        <form asp-controller="Friends" asp-action="Index" method="get" class="people-search" role="search">
            <label for="people-query">Find people</label>
            <div class="people-search-row">
                <div class="friends-search">
                    <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16 16 4 4"/></svg>
                    <input id="people-query" type="search" name="q" value="@query" placeholder="Search by name or email" />
                </div>
                <button class="friends-button" type="submit">Search</button>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(query))
        {
            <div class="people-results" aria-labelledby="results-heading">
                <div class="people-results-heading">
                    <h3 id="results-heading">Search results <span class="friends-count">@results.Count</span></h3>
                    <a asp-controller="Friends" asp-action="Index">Clear search</a>
                </div>
                @if (results.Count == 0)
                {
                    <p class="friends-empty">No people found. Try another name or email.</p>
                }
                else
                {
                    <ul class="friends-list">
                        @foreach (FriendSearchResultViewModel person in results)
                        {
                            <li class="friends-list-item">
                                <a class="friends-person people-result-profile" asp-controller="Profile" asp-action="Details" asp-route-userid="@person.UserId">
                                    @if (person.HasPicture)
                                        {
                                        <img class="friend-avatar" aria-hidden="true" style="object-fit: cover;"
                                            src="@Url.Action(action: "Photo", "Profile", new { id = person.UserId })"
                                            alt="@($"{person.DisplayName}'s profile photo")" />
                                        }
                                        else
                                        {
                                            <span aria-hidden="true">@Initials(person.DisplayName)</span>
                                        }
                                    <span><strong>@person.DisplayName</strong><small>@person.Email</small></span>
                                </a>
                                @if (person.RelationshipStatus == "None")
                                {
                                    <form asp-controller="Profile" asp-action="AddFriend" method="post">
                                        <input type="hidden" name="userId" value="@person.UserId" />
                                        <input type="hidden" name="fromFriends" value="true" />
                                        <input type="hidden" name="q" value="@query" />
                                        <button class="friends-button" type="submit" aria-label="Send friend request to @person.DisplayName">Send request</button>
                                    </form>
                                }
                                else if (person.RelationshipStatus == "Received")
                                {
                                    <a class="people-status" href="#requests-heading">Respond to request</a>
                                }
                                else
                                {
                                    <span class="people-status">@(person.RelationshipStatus == "Friends" ? "Friends" : "Request sent")</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        }

        @if (friends.Count == 0)
        {
            <div class="friends-empty">Your friends will appear here once you connect.</div>
        }
        else
        {
            <ul class="friends-grid">
                @foreach (FriendListItemViewModel friend in friends)
                {
                    var details = friendDetails != null && friendDetails.TryGetValue(friend.UserId, out var value) ? value : default;
                    <li class="friend-card">
                        <a class="friend-card-profile" asp-controller="Profile" asp-action="Details" asp-route-userid="@friend.UserId">
                            @if (friend.HasPicture)
                            {
                            <img class="friend-avatar" aria-hidden="true" style="object-fit: cover;"
                                src="@Url.Action(action: "Photo", "Profile", new { id = friend.UserId })"
                                alt="@($"{friend.DisplayName}'s profile photo")" />
                            }
                            else
                            {
                                <span aria-hidden="true">@Initials(friend.DisplayName)</span>
                            }
                            <span class="friend-card-names">
                                <strong>@friend.DisplayName</strong>
                                <small>@(string.IsNullOrWhiteSpace(details.Program) ? "BCIT student" : details.Program)</small>
                                @if (!string.IsNullOrWhiteSpace(details.Campus))
                                {
                                    <span class="friend-campus">@details.Campus campus</span>
                                }
                            </span>
                        </a>
                        <form asp-controller="Profile" asp-action="RemoveFriend" method="post" data-remove-friend data-friend-name="@friend.DisplayName">
                            <input type="hidden" name="relationshipId" value="@friend.RelationshipId" />
                            <button class="friends-remove" type="submit" aria-label="Remove @friend.DisplayName from friends" title="Remove friend">
                                <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M3 20v-1a6 6 0 0 1 12 0v1M17 11h5"/></svg>
                            </button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="friends-section" aria-labelledby="requests-heading">
        <div class="friends-section-heading">
            <div><h2 id="requests-heading">Incoming friend requests <span class="friends-count">@incomingRequests.Count</span></h2></div>
        </div>
        @if (incomingRequests.Count == 0)
        {
            <div class="friends-empty">No incoming requests right now.</div>
        }
        else
        {
            <ul class="friends-list">
                @foreach (IncomingFriendRequestViewModel request in incomingRequests)
                {
                    <li class="friends-list-item">
                        <div class="friends-person">
                            @if (request.HasPicture)
                            {
                            <img class="friend-avatar" aria-hidden="true" style="object-fit: cover;"
                                src="@Url.Action(action: "Photo", "Profile", new { id = request.RequesterId })"
                                alt="@($"{request.RequesterDisplayName}'s profile photo")" />
                            }
                            else
                            {
                            <span class="friend-avatar" aria-hidden="true">@Initials(request.RequesterDisplayName)</span>
                            }
                            <span><strong>@request.RequesterDisplayName</strong><small>Wants to connect</small></span>
                        </div>
                        <div class="friends-request-actions">
                            <form asp-controller="Profile" asp-action="RespondToFriendRequest" method="post">
                                <input type="hidden" name="requestId" value="@request.Id" />
                                <input type="hidden" name="decision" value="accept" />
                                <button class="friends-button" type="submit" aria-label="Accept request from @request.RequesterDisplayName">Accept</button>
                            </form>
                            <form asp-controller="Profile" asp-action="RespondToFriendRequest" method="post">
                                <input type="hidden" name="requestId" value="@request.Id" />
                                <input type="hidden" name="decision" value="deny" />
                                <button class="friends-secondary" type="submit" aria-label="Deny request from @request.RequesterDisplayName">Decline</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
    <section class="friends-section" aria-labelledby="sent-requests-heading">
        <div class="friends-section-heading">
            <h2 id="sent-requests-heading">Sent requests <span class="friends-count">@sentRequests.Count</span></h2>
        </div>
        @if (sentRequests.Count == 0)
        {
            <div class="friends-empty">No pending sent requests.</div>
        }
        else
        {
            <ul class="friends-list">
                @foreach (var request in sentRequests)
                {
                    <li class="friends-list-item">
                        <a class="friends-person people-result-profile" asp-controller="Profile" asp-action="Details" asp-route-userid="@request.UserId">
                            @if (request.HasPicture)
                            {
                                <img class="friend-avatar" aria-hidden="true" style="object-fit: cover;"
                                     src="@Url.Action(action: "Photo", "Profile", new { id = request.UserId })"
                                     alt="@($"{request.DisplayName}'s profile photo")" />
                            }
                            else
                            {
                                <span class="friend-avatar" aria-hidden="true">@Initials(request.DisplayName)</span>
                            }
                            <span><strong>@request.DisplayName</strong><small>Request pending</small></span>
                        </a>
                        <form asp-controller="Profile" asp-action="CancelFriendRequest" method="post" data-cancel-request data-recipient-name="@request.DisplayName">
                            <input type="hidden" name="relationshipId" value="@request.RelationshipId" />
                            <button class="friends-secondary" type="submit" aria-label="Cancel friend request to @request.DisplayName">Cancel request</button>
                        </form>
                    </li>
                }
            </ul>
        }
    </section>
    <dialog class="friends-confirm-dialog" aria-labelledby="cancel-request-title" aria-describedby="cancel-request-description" data-cancel-dialog>
        <div class="friends-confirm-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.5"/><path d="M3 20v-1a6 6 0 0 1 12 0v1M17 11h5"/></svg>
        </div>
        <h2 id="cancel-request-title">Cancel friend request?</h2>
        <p id="cancel-request-description">Your request to <strong data-cancel-recipient></strong> will be withdrawn. You can send another request later.</p>
        <div class="friends-confirm-actions">
            <button class="friends-secondary" type="button" data-keep-request autofocus>Keep request</button>
            <button class="friends-confirm-cancel" type="button" data-confirm-cancel>Cancel request</button>
        </div>
    </dialog>
</section>
@section Scripts {
    <script src="~/js/friends.js" asp-append-version="true" defer></script>
}
