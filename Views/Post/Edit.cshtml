@model BCIT_Social.ViewModels.EditPostViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@*
Edit post page. Same look as the create post popup (create-* styles in home.css), on a page instead
of a popup. Saves to PostController.Edit, which goes back to Model.ReturnUrl.
*@
@{
    ViewData["Title"] = "Edit post";
    Layout = "_HomeLayout";
}

<section class="panel edit-post" aria-labelledby="edit-post-title">
    <div class="create-dialog-top">
        <div>
            <h1 class="create-title" id="edit-post-title">Edit post</h1>
            <p class="create-subtitle">
                @if (Model.CommunityName is null)
                {
                    @:Update your post. Changes show up right away.
                }
                else
                {
                    @:Posted in <strong>@Model.CommunityName</strong>
                }
            </p>
        </div>
    </div>

    <form class="create-form" method="post" asp-action="Edit" asp-route-id="@Model.Id">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />

        <div class="create-form-body">
            <div asp-validation-summary="ModelOnly" class="create-error"></div>

            @{
                var tagChoices = Model.PostTypes.Select(tag => new SelectListItem(tag.Text, tag.Value, Model.TagIds.Contains(int.Parse(tag.Value))));
            }
            <partial name="_TagPicker" model='new BCIT_Social.ViewModels.TagPickerViewModel { Name = "TagIds", Options = tagChoices, Min = 1 }' />
            <span asp-validation-for="TagIds" class="create-error"></span>

            <div class="create-field">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" maxlength="150" required />
                <span asp-validation-for="Title" class="create-error"></span>
            </div>

            <div class="create-field">
                <label asp-for="Content">Content</label>
                <div class="content-editor">
                    <textarea asp-for="Content" rows="8" required></textarea>
                    <div class="content-toolbar" aria-label="Formatting (not available yet)">
                        <button type="button" disabled aria-label="Bold"><strong>B</strong></button>
                        <button type="button" disabled aria-label="Italic"><em>I</em></button>
                        <button type="button" disabled aria-label="Quote"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4Z" /></svg></button>
                        <button type="button" disabled aria-label="List"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 7h14M5 12h14M5 17h14" /></svg></button>
                    </div>
                </div>
                <span asp-validation-for="Content" class="create-error"></span>
            </div>
        </div>

        <div class="create-footer">
            <a class="secondary-button edit-post-cancel" href="@Model.ReturnUrl">Cancel</a>
            <button class="cta-button publish-button" type="submit">Save changes</button>
        </div>
    </form>
</section>
