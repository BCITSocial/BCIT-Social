@model BCIT_Social.ViewModels.CreatePostViewModel

@{
    ViewData["Title"] = "Create Post";
}

<h1>Create Post</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="TagId"></label>
        <input asp-for="TagId" class="form-control" />
        <span asp-validation-for="TagId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Content"></label>
        <textarea asp-for="Content" class="form-control" rows="6"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Create Post
    </button>

</form>

<div>
    <a asp-action="Index">Back to Posts</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}