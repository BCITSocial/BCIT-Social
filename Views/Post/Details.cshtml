@model BCIT_Social.ViewModels.PostDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "_HomeLayout";
}

<section class="post-details-card">

    <div class="post-details-header">

        <div class="post-author-meta">
            <strong class="post-author-name">
                @Model.AuthorName
            </strong>

            @if (!string.IsNullOrWhiteSpace(Model.PostType))
            {
                <span class="post-type">
                    @Model.PostType
                </span>
            }
        </div>

        <time datetime="@Model.CreatedAt.ToString("O")">
            @Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy • h:mm tt")
        </time>

    </div>

    <h1 class="post-details-title">
        @Model.Title
    </h1>

    <p class="post-details-content">@Model.Content</p>

    <div class="post-details-actions">

        @if (Model.CanEdit)
        {
            <a class="primary-button" asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Id">
                Edit post
            </a>

            <a class="danger-button" asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Id">
                Delete post
            </a>
        }

        <a class="secondary-button" asp-controller="Home" asp-action="Index">
            Back to Home
        </a>

    </div>

</section>