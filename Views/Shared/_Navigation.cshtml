@*
author: Andre Di Lascio
Renders sidebar navigation, marks the active controller route, and lists the user's communities.
*@

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<nav class="sidebar" aria-label="Main navigation">
    <button type="button" disabled>Messages</button>
    <ul class="sidebar-links">
        <li>
            <a asp-controller="Home" asp-action="Index" aria-current="@(currentController == "Home" ? "page" : null)">
                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 10.5 12 4l8 6.5V20h-5.5v-6h-5v6H4Z" /></svg>
                Home
            </a>
        </li>
        <li>
            <a asp-controller="Community" asp-action="Index" aria-current="@(currentController == "Community" ? "page" : null)">
                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="9" cy="8" r="3.2" /><path d="M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6" /><circle cx="17" cy="9" r="2.5" /><path d="M16 13.2c2.7.3 5 2.4 5 5.3" /></svg>
                Communities
            </a>
        </li>
        <li>
            <a asp-controller="Events" asp-action="Index" aria-current="@(currentController == "Events" ? "page" : null)">
                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5.5" width="16" height="14.5" rx="1.5" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" /></svg>
                Events
            </a>
        </li>
        <li>
            <a asp-controller="Profile" asp-action="Index" aria-current="@(currentController == "Profile" ? "page" : null)">
                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="5.5" width="16" height="14.5" rx="1.5" /><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" /></svg>
                Profile
            </a>
        </li>
        @* Replace disabled controls with route links as the team adds each screen. *@
        <li>
            <a asp-controller="Messages" asp-action="Index" aria-current="@(currentController == "Messages" ? "page" : null)">
                <svg class="sidebar-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4Z" /></svg>
                Messages
            </a>
        </li>
    </ul>
    @await Component.InvokeAsync("SidebarCommunities")
</nav>
