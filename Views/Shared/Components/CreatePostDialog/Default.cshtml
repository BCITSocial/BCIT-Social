@model BCIT_Social.ViewModels.CreatePostViewModel
@*
The create post modal (Home's Create button only makes posts). Submits the post title, content, and one tag
(TagId) to PostController.Create. Parts the backend doesn't handle yet are shown disabled: Post to and formatting.
create-post.js checks the fields and the chosen photos, shows previews, and sends the form in the background.
After a post is published the page reloads and shows a short "published" note, so the new post appears in the feed
as a normal card instead of opening on its own page.
TODO(BE): with JavaScript off the form is sent normally and PostController.Create redirects to /Home/Post/{id}
(the full page). Redirecting to Home/Index there instead would keep that path in the feed too.
*@
<dialog class="create-dialog" id="create-post-dialog" aria-labelledby="create-post-title"
        data-published-text="Your post was published." data-view-post-text="View post" data-dismiss-text="Dismiss"
        data-deleted-text="Your post was deleted.">
    <div class="create-dialog-top">
        <div class="create-heading">
            <h2 class="create-title" id="create-post-title">Create post</h2>
            <p class="create-subtitle">Start a conversation with your community.</p>
        </div>
        <button class="icon-button" type="button" data-close-create aria-label="Close">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
    </div>

    <form class="create-form" method="post" enctype="multipart/form-data" asp-area="" asp-controller="Post" asp-action="Create"
          novalidate data-create-post>
        <div class="create-form-body">
            @* Filled in by create-post.js: the error summary, or why the post couldn't be published. *@
            <p class="form-message" role="alert" data-form-message hidden></p>

            <div class="create-field">
                <label for="create-post-to">Post to</label>
                <select id="create-post-to" disabled>
                    <option>No community</option>
                </select>
                <p class="create-help">Posting to a community isn't available yet.</p>
            </div>

            @* One field for the post's tag: it used to be split into "Post type" and a separate, unused "Tags" field. *@
            <fieldset class="create-field" aria-describedby="create-post-type-error" data-error="Choose a tag.">
                <legend>Tag</legend>
                <div class="post-type-options">
                    @foreach (var type in Model.PostTypes)
                    {
                        <label class="post-type-option">
                            <input type="radio" name="TagId" value="@type.Value" required />
                            <span>@type.Text</span>
                        </label>
                    }
                </div>
                <p class="field-error" id="create-post-type-error" hidden></p>
            </fieldset>

            <div class="create-field">
                <div class="create-label-row">
                    <label for="create-post-title-input">Title</label>
                    @* Characters used out of the 150 allowed, kept up to date by create-post.js. *@
                    <span class="create-count" data-count-for="create-post-title-input" aria-hidden="true"></span>
                </div>
                <input id="create-post-title-input" name="Title" maxlength="150" placeholder="How do you organize MVC controllers?" required
                       aria-describedby="create-post-title-error" data-error="Enter a title." />
                <p class="field-error" id="create-post-title-error" hidden></p>
            </div>

            <div class="create-field">
                <label for="create-post-content">Content</label>
                <div class="content-editor">
                    <textarea id="create-post-content" name="Content" rows="5" placeholder="Share your question, idea, or update..." required
                              aria-describedby="create-post-content-error" data-error="Write something for your post."></textarea>
                    <div class="content-toolbar" aria-label="Formatting (not available yet)">
                        <button type="button" disabled aria-label="Bold"><strong>B</strong></button>
                        <button type="button" disabled aria-label="Italic"><em>I</em></button>
                        <button type="button" disabled aria-label="Quote"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 5h16v11H9l-5 4Z" /></svg></button>
                        <button type="button" disabled aria-label="List"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 7h14M5 12h14M5 17h14" /></svg></button>
                    </div>
                </div>
                <p class="field-error" id="create-post-content-error" hidden></p>
            </div>

            @* Photos: the box opens the file picker. create-post.js shows a preview of each chosen photo with a
               Remove button, and checks them against the upload rules in UploadService (post photos). *@
            <div class="create-field">
                <span class="create-label">Photos (optional)</span>
                <label class="attach-box" for="Photos">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3.5" y="5" width="17" height="14" rx="1.5" /><circle cx="9" cy="10" r="1.6" /><path d="m4 17 5-4.5 4 3.5 3-2.5 4 3.5" /></svg>
                    Add photos
                </label>
                <input asp-for="Photos" type="file" multiple class="visually-hidden" accept=".png,.jpg,.jpeg,.webp,.gif"
                       aria-describedby="create-post-photos-help create-post-photos-error"
                       data-max-bytes="@(20 * 1024 * 1024)" data-min-size="300"
                       data-error-type="{0} isn't a PNG, JPG, WEBP or GIF image."
                       data-error-size="{0} is larger than 20 MB."
                       data-error-dimensions="{0} is smaller than 300 × 300 pixels."
                       data-remove-text="Remove {0}" />
                <p class="create-help" id="create-post-photos-help">PNG, JPG, WEBP or GIF. Up to 20 MB each, at least 300 × 300 pixels.</p>
                <ul class="photo-previews" data-photo-previews hidden></ul>
                <p class="field-error" id="create-post-photos-error" hidden></p>
                <span asp-validation-for="Photos" class="text-danger"></span>
            </div>
        </div>

        <div class="create-footer">
            <button class="secondary-button" type="button" data-close-create>Cancel</button>
            <button class="cta-button publish-button" type="submit" data-submitting-text="Publishing..."
                    data-error-summary="Check the highlighted fields."
                    data-error-failed="Your post couldn't be published. Try again.">Publish post</button>
        </div>
    </form>
</dialog>
