@using BCIT_Social.ViewModels
@model RailLinkViewModel
@* One row in the Quick links card, built from one entry in "links" in right-rail-text.json.
   The detail line is left out when it is empty. Links starting with http open in a new tab. *@
@{
    var text = ViewData[nameof(RightRailText)] as RightRailText ?? new RightRailText();
}
<a class="rail-link" href="@Model.Url" target="@(Model.IsExternal ? "_blank" : null)" rel="@(Model.IsExternal ? "noopener noreferrer" : null)">
    <svg class="rail-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        @switch (Model.Icon)
        {
            case "book":
                <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5Z" /><path d="M4 20.5A2.5 2.5 0 0 1 6.5 18H20v3H6.5A2.5 2.5 0 0 1 4 20.5Z" />
                break;
            case "people":
                <circle cx="9" cy="8" r="3.2" /><path d="M3 19c0-3.3 2.7-6 6-6s6 2.7 6 6" /><circle cx="17" cy="9" r="2.5" /><path d="M16 13.2c2.7.3 5 2.4 5 5.3" />
                break;
            case "pin":
                <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" />
                break;
            case "code":
                <path d="m8 7-5 5 5 5M16 7l5 5-5 5" />
                break;
            case "chat":
                <path d="M4 5h16v11H9l-5 4Z" />
                break;
            default:
                <path d="M7 17 17 7M9 7h8v8" />
                break;
        }
    </svg>
    <span class="rail-link-text">
        <span class="rail-link-title">@Model.Title</span>
        @if (Model.Detail.Length > 0)
        {
            <span class="rail-muted">@Model.Detail</span>
        }
    </span>
    @if (Model.IsExternal)
    {
        <span class="visually-hidden">@text.NewTab</span>
    }
</a>
