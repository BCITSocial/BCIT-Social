@using BCIT_Social.ViewModels
@model RightRailViewModel
@{
    var text = Model.Text;
    // The entry partials read their button and count text from here.
    ViewData[nameof(RightRailText)] = text;
}
@* Right rail: one card slot per name in Model.Cards, in that order. Each card is a heading plus a list of entries
   from right-rail-text.json; with no entries the card keeps its place and shows its empty message.
   All wording comes from Model.Text; this file only places it. *@
<aside class="right-rail" aria-label="@text.RailLabel">
    @foreach (var card in Model.Cards)
    {
        switch (card)
        {
            case RightRailCards.Events:
                <section class="rail-card" aria-labelledby="rail-events-heading">
                    <div class="rail-card-head">
                        <h2 id="rail-events-heading">@text.EventsHeading</h2>
                        <a asp-controller="Events" asp-action="Index">@text.EventsLink</a>
                    </div>
                    @if (Model.Events.Count == 0)
                    {
                        <p class="rail-empty">@text.EventsEmpty</p>
                    }
                    else
                    {
                        <ul class="rail-list rail-events">
                            @foreach (var item in Model.Events)
                            {
                                <li><partial name="~/Views/Shared/Components/RightRail/_RailEvent.cshtml" model="item" /></li>
                            }
                        </ul>
                    }
                </section>
                break;

            case RightRailCards.Links:
                <section class="rail-card" aria-labelledby="rail-links-heading">
                    <div class="rail-card-head">
                        <h2 id="rail-links-heading">@text.LinksHeading</h2>
                    </div>
                    @if (Model.Links.Count == 0)
                    {
                        <p class="rail-empty">@text.LinksEmpty</p>
                    }
                    else
                    {
                        <ul class="rail-list">
                            @foreach (var item in Model.Links)
                            {
                                <li><partial name="~/Views/Shared/Components/RightRail/_RailLink.cshtml" model="item" /></li>
                            }
                        </ul>
                    }
                </section>
                break;
        }
    }
</aside>
