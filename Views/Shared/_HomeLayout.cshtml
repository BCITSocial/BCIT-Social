@*
author: Andre Di Lascio
Provides the shared page structure, styles, header, navigation, and script section.
*@

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BCIT Social</title>
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/right-rail.css" asp-append-version="true" />
</head>
@* The theme script uses the signed-in user's ID to load their saved appearance. *@
<body data-profile-user-id="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value">
    <script src="~/js/profile-theme.js" asp-append-version="true"></script>
    @* A page shows the right rail by listing card slots, e.g. ViewData["RightRail"] = new[] { RightRailCards.Events, RightRailCards.Links }. *@
    @{ var rightRail = ViewData["RightRail"] as IReadOnlyList<string>; }
    <a class="skip-link" href="#main-content">Skip to content</a>
    <partial name="_Header" />
    @* Three columns: the nav pinned to the left edge, the page centred, and a right column pinned to the right
       edge. A page fills the right column with @section RightPanel { ... }, or lists right-rail cards in ViewData["RightRail"]. *@
    <div class="app-shell@(rightRail is null ? "" : " has-rail")">
        <partial name="_Navigation" />
        @* Dims the page behind the slide-out menu on phones; a tap closes the menu. *@
        <div class="nav-backdrop" hidden data-nav-backdrop></div>
        <main id="main-content" tabindex="-1">
            @RenderBody()
        </main>
        @if (rightRail is not null)
        {
            @await Component.InvokeAsync("RightRail", new { cards = rightRail })
        }
        else
        {
            <div class="shell-right">
                @await RenderSectionAsync("RightPanel", required: false)
            </div>
        }
    </div>
    @if (ViewData["UseMinimalSiteShell"] as bool? != true)
    {
        @await Component.InvokeAsync("CreatePostDialog")
        <script src="~/js/create-post.js" asp-append-version="true" defer></script>
    }
    <script src="~/js/nav-drawer.js" asp-append-version="true" defer></script>
    <script src="~/js/header-search.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
